---
import '../styles/tokens.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FubPixel from '../components/FubPixel.astro';
import { useTranslations, localizePath, asset, type Locale } from '../i18n/ui';

/* Imported rather than written as paths so Vite emits them with the same
   content hash and deployment folder it gives the @font-face rules in
   tokens.css. A preload whose URL differs from the one the stylesheet asks for
   downloads the face twice and warns in the console. */
import montserratThin from '../assets/fonts/Montserrat-Thin.woff2?url';
import montserratLight from '../assets/fonts/Montserrat-Light.woff2?url';

/* The share-card loop. Imported rather than written as a path so Vite emits it
   and hashes it — a share card is cached hard by every platform that reads it,
   and a content hash is what makes a replacement actually take. */
import ogVideo from '../assets/og/origin-residences-loop.mp4?url';

interface Props {
  title: string;
  description: string;
  locale?: Locale;
  /** Page path without locale prefix, e.g. "residences/" — drives hreflang. */
  path?: string;
  /** Dark page chrome for photography-led pages (home, gallery). */
  darkHeader?: boolean;
  /** Keep the page out of search results — used by unreleased residences. */
  noindex?: boolean;
  /** 'home' swaps in the homepage header, which holds the bar transparent
      over the hero photograph and opens a centre slot for the flying logo.
      Every other page keeps the default, so this cannot affect them. */
  headerVariant?: 'default' | 'home';
  ogImage?: string;
}

const {
  title,
  description,
  locale = 'en',
  path = '',
  darkHeader = false,
  noindex = false,
  headerVariant = 'default',
  ogImage = '/og-default.jpg',
} = Astro.props;

/* The GitHub Pages review deploy must not be indexed — it would compete with
   the real site and show the client's pre-launch pricing in search results.
   A robots.txt cannot do this job: the deploy is a *project* page, so its
   robots.txt would sit at /origin-residences/robots.txt, and crawlers only
   read the one at the domain root, which this repo does not control. The meta
   tag is per-page and therefore the only reliable lever. CI sets the variable;
   a production build leaves it unset and is indexed normally. */
const reviewDeploy = process.env.REVIEW_DEPLOY === 'true';

const t = useTranslations(locale);
const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://originresidences.com';
const canonical = `${site}${localizePath(path, locale)}`;
const locales: Locale[] = ['en', 'es', 'pt-br'];
const hreflangFor: Record<Locale, string> = { en: 'en-US', es: 'es-ES', 'pt-br': 'pt-BR' };
---

<!doctype html>
<html lang={hreflangFor[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(noindex || reviewDeploy) && <meta name="robots" content="noindex, nofollow" />}

    {locales.map((l) => (
      <link rel="alternate" hreflang={hreflangFor[l]} href={`${site}${localizePath(path, l)}`} />
    ))}
    <link rel="alternate" hreflang="x-default" href={`${site}${localizePath(path, 'en')}`} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Origin Residences" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {/* The still comes FIRST on purpose. It is the fallback in the only sense
        Open Graph has one: a platform that cannot or will not play video uses
        the image instead, and several read the first image they find. Nothing
        here makes a platform play the loop — that is its decision — so the
        card has to be complete without it. */}
    <meta property="og:image" content={`${site}${asset(ogImage)}`} />

    {/* No og:image:width/height. They are optional — a scraper fetches the
        image and measures it — and `ogImage` is a prop any page can override,
        so a hardcoded pair is a claim that goes wrong the first time someone
        passes a different picture. It nearly did here: the default is 1200x675
        and the first draft of this block asserted 630, copied from the video
        beside it. The video's dimensions ARE stated, because og:video is
        skipped without them and it is one fixed file. */}

    {/* 1200x630, H.264, 15.8s — measured off the file, not assumed. Dimensions
        are required: without them most scrapers skip the video outright.
        `secure_url` is the one Facebook actually reads; plain `og:video` is
        kept for readers that only know the older property. */}
    <meta property="og:video" content={`${site}${ogVideo}`} />
    <meta property="og:video:secure_url" content={`${site}${ogVideo}`} />
    <meta property="og:video:type" content="video/mp4" />
    <meta property="og:video:width" content="1200" />
    <meta property="og:video:height" content="630" />

    {/* Deliberately still `summary_large_image`. X plays video only through a
        Player card, which needs a separate HTTPS player page and its own
        approval — `og:video` alone does nothing there. This card shows the
        still, which is the intended fallback rather than a broken promise. */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={`${site}${asset(ogImage)}`} />

    <meta name="theme-color" content="#082341" />
    <link rel="icon" href={asset("favicon.svg")} type="image/svg+xml" />

    {/* The brand face carries every glyph on the page — preload the two
        weights that appear above the fold, not the whole kit. */}
    <link rel="preload" href={montserratThin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={montserratLight} as="font" type="font/woff2" crossorigin />

    {/* Lead delivery. Must load in <head> so it is listening before the
        visitor can reach a form. */}
    <FubPixel />

    <slot name="head" />
  </head>

  <body data-locale={locale}>
    <!--
      DIRECTION CONTRACT — Origin Residences · seed key 82394146
      THESIS: The incumbent brand, rebuilt as a fast static site. A replacement
        visual world (Chart Datum) was rolled, presented and DECLINED by the
        owner on brand-standards grounds; the standing exit was taken, so the
        commitment is fidelity. This refuses the rebuild-as-reinvention reflex.
      OWN-WORLD: Navy #082341, warm sand #e6dfd5, antique gold #ba935b.
        Montserrat Thin/ExtraLight/Light ONLY, uppercase, widely tracked.
        Hierarchy from scale, case and tracking — never from weight. Full-bleed
        photography on sand and navy grounds, hairline gold rules.
      STORY: A buyer or broker understands this is a boutique 27-residence
        waterfront building with Artefacto interiors, and acts by inquiring or
        booking a private presentation.
      FIRST VIEWPORT: Full-bleed sunset photograph under a transparent fixed
        bar; the wordmark stands oversized above the copy and flies up into the
        bar on scroll, which fills as it lands. The 27-residence headline in
        tracked light caps, gold rule beneath, VIEW TRAILER as primary action —
        the brand film now plays on demand rather than autoplaying behind the
        type. Chosen by the owner over the video hero, which is retired but
        kept at src/components/Hero.astro.
      FORM: Refinement of the incumbent world (the standing exit), not
        candidate 4 of the grounded list. Identity fixed; execution rebuilt.
      FINISH: unreviewed and undocumented is unfinished; this build ends with
        the finish review, the verdict, and DESIGN.md
    -->

    <a class="skip-link" href="#main">{t('skip')}</a>

    <Header locale={locale} dark={darkHeader} variant={headerVariant} />

    <main id="main">
      <slot />
    </main>

    <Footer locale={locale} />

    <script>
      import { initMotion } from '../scripts/motion';
      initMotion();
    </script>
  </body>
</html>
