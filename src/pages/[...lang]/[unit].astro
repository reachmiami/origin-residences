---
/**
 * A RESIDENCE, as a listing sheet.
 *
 * Structured the way a property portal sets a listing — photographic hero, a
 * strip of headline figures, then the specification blocks with an inquiry
 * form held alongside them — because that is the order a buyer and a buyer's
 * agent already know how to read. The rendering is Origin's own: Montserrat in
 * light weights, tracked caps for the labels, gold hairlines, sand and navy.
 * The structure is borrowed; the visual world is not.
 *
 * ─── ONLY RELEASED RESIDENCES GET A PAGE ───────────────────────────────────
 * This used to build all 27 and leave the unreleased ones unlinked, noindex
 * and out of the sitemap but still reachable by direct URL, so one could be
 * sent to a broker ahead of release. That is no longer the rule: a residence
 * that is not released is not on the website, and its asking price is not
 * served to anyone who guesses the URL. Withdrawing one now 404s its page.
 *
 * The route is built from `units`, the released-only set, so the single switch
 * in src/data/released.json decides what exists — the same switch that decides
 * what is linked. What a page shows still varies with how much data a
 * residence has: ListingSpecs drops an empty row, and a block whose rows all
 * drop removes itself.
 */
import fs from 'node:fs';
import path from 'node:path';
import sharp from 'sharp';
import Base from '../../layouts/Base.astro';
import ListingCarousel, { type Slide } from '../../components/ListingCarousel.astro';
import ListingSpecs, { type SpecRow } from '../../components/ListingSpecs.astro';
import InquiryForm from '../../components/InquiryForm.astro';
import PresentationCTA from '../../components/PresentationCTA.astro';
import {
  useTranslations,
  asset,
  localeFromParam,
  locales,
  defaultLocale,
} from '../../i18n/ui';
import { getCopy } from '../../content/copy';
import { unitCopy } from '../../content/pages/residences';
import { listingsCopy } from '../../content/pages/listings';
import { galleryCopy } from '../../content/pages/gallery';
import { galleryArt } from '../../data/gallery-art';
import { mediaFor } from '../../data/listing-media';
import {
  BUILDING,
  formatPrice,
  listingForUnit,
} from '../../data/listings';
import { units, formatSqft, type Unit } from '../../data/units';

export function getStaticPaths() {
  return locales.flatMap((l) =>
    units.map((unit) => ({
      params: { lang: l === defaultLocale ? undefined : l, unit: unit.slug },
      props: { unit },
    })),
  );
}

interface Props {
  unit: Unit;
}

const { unit } = Astro.props;

const locale = localeFromParam(Astro.params?.lang);
const t = useTranslations(locale);
const c = getCopy(locale);
const u = unitCopy[locale];
const l = listingsCopy[locale];

const listing = listingForUnit(unit);
const { facts } = listing;

/* Bed/bath wording is a label and is translated; the counts behind it are data
   and are read straight off the record. */
const bedBath = u.bedBath({
  beds: unit.beds,
  hasDen: unit.hasDen,
  baths: unit.baths,
  label: unit.bedBathLabel,
});

const levelLabel = unit.level === 7 ? `PH ${t('level')} ${unit.level}` : `${t('level')} ${unit.level}`;
const heading = `${levelLabel} · ${t('unit')} ${unit.number}`;

/* Dates render in the reader's conventions — 04/14/2025 for an American buyer,
   14/04/2025 for a Spanish or Brazilian one. The stored value is ISO and is
   never displayed raw. */
const dateLocale = { en: 'en-US', es: 'es-ES', 'pt-br': 'pt-BR' }[locale];
const listedDisplay = facts.dateListed
  ? new Date(`${facts.dateListed}T00:00:00`).toLocaleDateString(dateLocale)
  : null;

/* Photography for the hero, with alt text reused from the gallery, where it
   was written in all three languages after looking at the actual file. */
const media = mediaFor(unit.number);
const altFor = (id: string) =>
  galleryCopy[locale].photos.find((p) => p.id === id)?.alt ?? BUILDING.subdivision;

const slides: Slide[] = media.carousel
  .filter((id) => galleryArt[id])
  .map((id) => ({ src: galleryArt[id], alt: altFor(id) }));

/* The residence's own drawing, if the developer supplied one.
   ---------------------------------------------------------------------------
   The image and the PDF both come from routes under /floorplans/ rather than
   from imports, so a residence withdrawn from src/data/released.json loses
   them along with its page — see src/pages/floorplans/[plan].webp.ts for why
   an import cannot be made to do that. The source file is consulted here only
   to learn whether a drawing exists and what shape it is; it is never bundled.

   The level keyplan that used to stand in when a residence had no drawing of
   its own is gone. It was a drawing of the FLOOR offered in place of a drawing
   of the RESIDENCE, it survives on the Floor Plans page where it belongs, and
   keeping it here meant importing eleven drawings so that one might be used. */
const planSource = path.resolve(
  'src/listings/floorplans/previews',
  `floor-plan-${unit.number}.png`,
);
const hasPlan = fs.existsSync(planSource);

/* Read at build so the <img> reserves its exact box and the specification
   below it does not jump when the drawing arrives. */
const planRatio = hasPlan
  ? await sharp(planSource).metadata().then((m) => `${m.width} / ${m.height}`)
  : null;

const planImage = hasPlan ? asset(`floorplans/floor-plan-${unit.number}.webp`) : null;
const planPdf = hasPlan ? asset(`floorplans/floor-plan-${unit.number}.pdf`) : null;
const planAlt = l.floorPlanAlt(unit.number);

const money = (n: number | null) => (n === null ? null : formatPrice(n));

const basicRows: SpecRow[] = [
  { label: l.mls, value: facts.mls },
  { label: l.type, value: BUILDING.propertyType },
  { label: l.subdivision, value: BUILDING.subdivision },
  { label: l.yearBuilt, value: BUILDING.yearBuilt },
  { label: l.totalSqft, value: formatSqft(unit.totalSqft) },
  { label: l.dateListed, value: listedDisplay },
  { label: l.daysOnMarket, value: listing.daysOnMarket },
];

const exteriorRows: SpecRow[] = [
  { label: l.waterfront, value: BUILDING.waterfront ? l.yes : l.no },
  { label: l.wfDescription, value: BUILDING.waterfrontDescription },
  { label: l.parkingSpaces, value: facts.parkingSpaces },
  { label: l.parkingDescription, value: facts.parkingDescription },
  { label: l.pool, value: BUILDING.pool ? l.yes : l.no },
  { label: l.exteriorFeaturesField, value: BUILDING.exteriorFeatures.join(', ') },
];

/* The MLS sheet prints "Adjusted Sqft" and "Sqft" as separate fields holding
   the same number, and "Subdivision" in two blocks at once. That redundancy is
   an artifact of the feed, and reproducing it on a sales page reads as a
   mistake rather than as fidelity — each figure is stated once. */
const interiorRows: SpecRow[] = [
  { label: l.adjustedSqft, value: `${formatSqft(unit.interiorSqft)} ${l.sqftUnit}` },
  {
    label: l.interiorFeaturesField,
    value: facts.interiorFeatures.length ? facts.interiorFeatures.join(', ') : null,
  },
];

const propertyRows: SpecRow[] = [
  { label: l.lotSize, value: facts.lotSize ? formatSqft(facts.lotSize) : null },
  { label: l.furnished, value: facts.furnished },
  { label: l.shortSale, value: facts.shortSale },
  { label: l.hoaFees, value: money(facts.hoaFees) },
  { label: l.taxAmount, value: money(facts.taxAmount) },
  { label: l.taxYear, value: facts.taxYear },
];

/* The headline strip. Half baths only appear where there is one — "0 Half
   Bath" is noise — and $/sq. ft. only where a price exists to divide. */
const stats = [
  { value: String(unit.beds), label: l.statBed },
  { value: String(listing.bathsFull), label: l.statBath },
  ...(listing.bathsHalf ? [{ value: String(listing.bathsHalf), label: l.statHalfBath }] : []),
  { value: formatSqft(unit.interiorSqft), label: l.statSize },
  ...(listing.pricePerSqft
    ? [{ value: formatPrice(listing.pricePerSqft), label: l.statPerSqft }]
    : []),
];
---

<Base
  title={l.metaTitle(unit.number, bedBath)}
  description={l.metaDescription(unit.number, bedBath, formatSqft(unit.interiorSqft))}
  locale={locale}
  path={unit.slug}
  darkHeader
>
  <h1 class="visually-hidden">{heading}</h1>

  <ListingCarousel slides={slides} locale={locale} residence={unit.number} />

  <div class="listing">
    <div class="shell">
      {/* Headline figures. The price leads; the rest are the numbers a buyer
          scans before reading a word of prose. */}
      <div class="listing__stats">
        <p class="listing__price">
          {facts.price ? formatPrice(facts.price) : l.priceOnRequest}
          <span class="listing__address">{listing.addressLine}, {BUILDING.cityStateZip}</span>
        </p>

        <dl class="listing__figures">
          {stats.map((s) => (
            <div class="listing__figure">
              <dd class="listing__figure-value">{s.value}</dd>
              <dt class="listing__figure-label">{s.label}</dt>
            </div>
          ))}
        </dl>
      </div>

      <div class="listing__cols">
        <div class="listing__main">
          {/* The building description opens the left column rather than
              spanning the page, so it shares a measure with the specification
              under it and the form beside it starts at the same height. */}
          <section class="listing__intro" aria-label={BUILDING.subdivision}>
            <p class="listing__lede">{l.description}</p>
          </section>

          <ListingSpecs title={l.basicInformation} rows={basicRows} headingId="spec-basic" />

          <ListingSpecs title={l.amenities} headingId="spec-amenities">
            <ul class="amenity-list">
              {BUILDING.amenities.map((a) => <li>{a}</li>)}
            </ul>
          </ListingSpecs>

          <ListingSpecs title={l.exteriorFeatures} rows={exteriorRows} headingId="spec-exterior" />
          <ListingSpecs title={l.interiorFeatures} rows={interiorRows} headingId="spec-interior" />
          <ListingSpecs title={l.propertyFeatures} rows={propertyRows} headingId="spec-property" />

          {planImage && (
            <ListingSpecs title={l.floorPlan} headingId="spec-plan">
              <figure class="plan__figure">
                <img
                  src={planImage}
                  alt={planAlt}
                  style={`aspect-ratio: ${planRatio}`}
                  loading="lazy"
                  decoding="async"
                  class="plan__img"
                />
              </figure>

              {planPdf && (
                <p class="plan__download">
                  <a class="btn btn--ghost" href={planPdf} target="_blank" rel="noopener">
                    {l.downloadFloorPlan}
                    <span class="plan__pdf-note">{u.pdfNewTab}</span>
                  </a>
                </p>
              )}
            </ListingSpecs>
          )}
        </div>

        {/* The form rides alongside the specification on wide screens and
            follows it on narrow ones. It is the same InquiryForm the rest of
            the site uses, carrying this residence's slug so a lead arrives
            attached to the residence it came from — see src/scripts/leads.ts. */}
        <aside class="listing__aside">
          <div class="listing__form">
            <InquiryForm
              locale={locale}
              variant="compact"
              unit={unit.slug}
              headingId="inquire-heading"
              title={`${c.forms.requestInfoTitle} · ${t('unit')} ${unit.number}`}
            />
          </div>
        </aside>
      </div>
    </div>
  </div>

  <PresentationCTA locale={locale} />
</Base>

<style>
  .listing {
    padding-block: var(--s-7) var(--section-y);
    background: var(--ground);
  }

  /* ── Headline strip ─────────────────────────────────────────────────── */

  .listing__stats {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--s-5);
    padding-bottom: var(--s-6);
    border-bottom: 1px solid var(--rule);
  }

  .listing__price {
    margin: 0;
    color: var(--ink);
    font-size: var(--t-h2);
    font-weight: var(--w-light);
    letter-spacing: var(--track-display);
    line-height: 1.1;
  }

  .listing__address {
    display: block;
    margin-top: var(--s-2);
    color: var(--ink-muted);
    font-size: var(--t-small);
    letter-spacing: var(--track-body);
  }

  .listing__figures {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-6);
    margin: 0;
  }

  /* dd before dt in the DOM so the figure reads above its label, which is the
     order the eye wants; the pairing stays a definition list for semantics. */
  .listing__figure {
    text-align: center;
  }

  .listing__figure-value {
    margin: 0;
    color: var(--ink);
    font-size: var(--t-h3);
    font-weight: var(--w-light);
    line-height: 1.1;
  }

  .listing__figure-label {
    margin-top: var(--s-2);
    color: var(--ink-muted);
    font-size: var(--t-micro);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
  }

  .listing__intro {
    padding-bottom: var(--s-6);
  }

  .listing__lede {
    margin: 0;
    color: var(--ink-muted);
    font-size: var(--t-body);
    line-height: var(--leading-body);
  }

  /* ── Two columns ────────────────────────────────────────────────────── */

  .listing__cols {
    display: grid;
    align-items: start;
    gap: var(--s-8);
    margin-top: var(--s-7);
    grid-template-columns: minmax(0, 1fr) minmax(320px, 380px);
  }

  /* THE reason the sticky form would not stick.
     `align-items: start` on the grid shrinks each item to its own content, so
     the column holding the form was only as tall as the form — and a sticky
     element can never travel further than its own parent. Stretching this one
     item back to the full row height gives it the whole specification to
     travel alongside. The left column keeps `start`. */
  .listing__aside {
    align-self: stretch;
    height: 100%;
  }

  .listing__main > .listing__intro:first-child,
  .listing__main > :global(.specs:first-child) {
    border-top: 0;
    padding-top: 0;
  }

  .listing__form {
    position: sticky;
    top: calc(var(--header-h, 80px) + var(--s-4));
    /* A form taller than the gap below the header can never come to rest —
       it scrolls with the page forever because its bottom is always still
       below the fold. Capping it at the remaining viewport and letting it
       scroll internally is what actually makes it stay in view. */
    max-height: calc(100vh - var(--header-h, 80px) - var(--s-6));
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
  }

  /* ── Form, in this column only ──────────────────────────────────────────
     InquiryForm centres its heading and lede, which is right where it runs
     full width at the foot of a page. In a narrow column beside a left-ranged
     specification, centred type reads as a different document. These are
     :global because the component's own styles are scoped to it and cannot be
     reached by class name — and they are nested inside .listing__form so they
     cannot touch the same component anywhere else on the site. */
  .listing__form :global(.form-block__head) {
    justify-items: start;
    text-align: start;
  }

  .listing__form :global(.form-block__head .heading) {
    font-size: var(--t-h4);
    letter-spacing: var(--track-heading);
  }

  .listing__form :global(.form-block__lede) {
    text-align: start;
  }

  /* ── Amenities and floor plan ───────────────────────────────────────── */

  .amenity-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-4);
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--ink);
    font-size: var(--t-small);
  }

  .amenity-list li + li {
    padding-inline-start: var(--s-4);
    border-inline-start: 1px solid var(--rule);
  }

  .plan__figure {
    margin: 0;
    padding: var(--s-4);
    border: 1px solid var(--rule);
    background: var(--off-white);
  }

  .plan__img {
    width: 100%;
    height: auto;
  }

  .plan__download {
    margin: var(--s-5) 0 0;
  }

  .plan__pdf-note {
    margin-inline-start: var(--s-2);
    font-size: var(--t-micro);
    letter-spacing: var(--track-body);
    opacity: 0.75;
    text-transform: none;
  }

  @media (max-width: 1080px) {
    .listing__cols {
      grid-template-columns: minmax(0, 1fr);
    }

    /* Sticky is a desktop affordance; on one column it would pin the form over
       the specification the visitor is trying to read. */
    .listing__form {
      position: static;
    }
  }

  @media (max-width: 700px) {
    .listing__stats {
      align-items: flex-start;
      flex-direction: column;
    }

    .listing__figures {
      gap: var(--s-5);
    }

    .listing__figure {
      text-align: start;
    }
  }
</style>
