---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import NeighborhoodMap from '../../components/NeighborhoodMap.astro';
import PresentationCTA from '../../components/PresentationCTA.astro';
import InquiryForm from '../../components/InquiryForm.astro';
import { localeStaticPaths, localeFromParam } from '../../i18n/ui';
import { neighborhoodCopy } from '../../content/pages/neighborhood';

import canalView from '../../assets/neighborhood/canal-view-from-terraces.jpg';
import streetApproach from '../../assets/neighborhood/origin-street-approach.jpg';
import fromTheWater from '../../assets/neighborhood/origin-from-the-water.jpg';
import { ADDRESS, MAP_HREF, PHONE, PHONE_HREF } from '../../data/contact';

export function getStaticPaths() {
  return localeStaticPaths();
}

const locale = localeFromParam(Astro.params?.lang);
const c = neighborhoodCopy[locale];


---

<Base
  title={c.metaTitle}
  description={c.metaDescription}
  locale={locale}
  path="neighborhood"
>
  {/* Same page-head treatment as Amenities and Gallery — centred, on the sand
      ground. `darkHeader` is gone with the photographic band it belonged to:
      the bar now opens over a light ground and needs its dark ink. */}
  <section class="page-head" aria-labelledby="page-heading">
    <div class="shell shell--narrow page-head__inner">
      <p class="eyebrow" data-reveal="fade">{c.eyebrow}</p>
      <h1 class="display page-head__title" id="page-heading" data-reveal>{c.headline}</h1>
      <hr class="page-head__rule" data-reveal="fade" />
      <p class="prose page-head__lede" data-reveal data-reveal-delay="0.08">{c.lede}</p>
    </div>
  </section>

  <figure class="band band--wide">
    <Image
      src={canalView}
      alt={c.alt.canal}
      widths={[640, 960, 1280, 1500]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      data-parallax="8"
    />
  </figure>

  <section class="section intro">
    <div class="shell shell--narrow intro__inner">
      <p class="prose intro__body" data-reveal>{c.intro}</p>
    </div>
  </section>

  <section class="section section--alt locate" aria-labelledby="locate-heading">
    <div class="shell locate__grid">
      <div class="locate__text" data-reveal>
        <h2 class="heading" id="locate-heading">{c.salesGalleryTitle}</h2>
        <hr class="locate__rule" />
        <a class="locate__address" href={MAP_HREF} target="_blank" rel="noopener noreferrer">
          {ADDRESS}
        </a>
        <a class="locate__phone" href={PHONE_HREF}>{PHONE}</a>
      </div>

      <figure class="locate__figure" data-reveal="fade">
        <Image
          src={streetApproach}
          alt={c.alt.street}
          widths={[480, 720, 1080]}
          sizes="(max-width: 880px) 100vw, 46vw"
        />
      </figure>
    </div>
  </section>


  <NeighborhoodMap locale={locale} />

  <figure class="band band--tall">
    <Image
      src={fromTheWater}
      alt={c.alt.water}
      widths={[640, 960, 1280, 1500]}
      sizes="100vw"
      data-parallax="8"
    />
  </figure>

  <PresentationCTA locale={locale} />

  <section class="section section--alt" id="inquire" aria-labelledby="inquire-heading">
    <div class="shell">
      <InquiryForm locale={locale} variant="full" headingId="inquire-heading" />
    </div>
  </section>
</Base>

<style>
  /* The page head is shared from tokens.css. The `.band` rules below are a
     DIFFERENT thing — this page's own full-bleed figures — and stay. */

  /* --- Full-bleed photography bands --------------------------------------
     The wrapper owns the crop; the image fills it and drifts slowly inside
     the clip. Specificity here deliberately beats Astro's responsive styles. */
  .band {
    position: relative;
    overflow: clip;
    background: var(--navy-deep);
  }

  .band--wide { aspect-ratio: 16 / 7; }
  .band--tall { aspect-ratio: 16 / 6; }

  .band :global(img) {
    position: absolute;
    inset: -6% 0;
    width: 100%;
    max-width: none;
    height: 112%;
    object-fit: cover;
  }

  .intro__inner { text-align: center; justify-items: center; display: grid; }

  .intro__body {
    font-size: var(--t-h4);
    font-weight: var(--w-xlight);
    color: var(--ink);
  }

  /* --- Sales gallery ------------------------------------------------------ */
  .locate__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(var(--s-6), 5vw, var(--s-9));
    align-items: center;
  }

  .locate__text { display: grid; gap: var(--s-4); align-content: start; }

  .locate__rule {
    width: clamp(48px, 6vw, 90px);
    height: 1px;
    border: 0;
    background: var(--gold);
    margin-block: var(--s-2);
  }

  .locate__address,
  .locate__phone {
    display: inline-block;
    font-size: var(--t-h4);
    font-weight: var(--w-xlight);
    letter-spacing: var(--track-body);
    color: var(--ink);
    padding-block: var(--s-2);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .locate__address:hover,
  .locate__phone:hover { color: var(--gold-ink); }

  .locate__figure { margin: 0; }


  @media (max-width: 880px) {
    .locate__grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 640px) {
    .band--wide { aspect-ratio: 4 / 3; }
    .band--tall { aspect-ratio: 4 / 3; }
  }
</style>
