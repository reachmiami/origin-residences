---
import Base from '../../layouts/Base.astro';
import InquiryForm from '../../components/InquiryForm.astro';
import PresentationCTA from '../../components/PresentationCTA.astro';
import AmenityStack from '../../components/AmenityStack.astro';
import { localeStaticPaths, localeFromParam } from '../../i18n/ui';
import { amenitiesCopy } from '../../content/pages/amenities';


/* One glob per amenity folder, so dropping another photograph into a folder
   puts it into that card's slideshow with no code change — which matters,
   because four of the six currently hold a single image and the owner is still
   supplying them.

   Globbed per folder rather than once across `amenities/*`, deliberately:
   `eager: true` imports every match, and a single wildcard would also pull in
   `amenities/random/` — eight unused files including multi-megabyte brochure
   PNGs — and put them through the image pipeline on every build. */
const folders = {
  'rooftop-pool': import.meta.glob<ImageMetadata>('../../assets/amenities/rooftop/*.{jpg,jpeg,png}', { eager: true, import: 'default' }),
  'aqua-club': import.meta.glob<ImageMetadata>('../../assets/amenities/aqua-club/*.{jpg,jpeg,png}', { eager: true, import: 'default' }),
  clubroom: import.meta.glob<ImageMetadata>('../../assets/amenities/clubroom/*.{jpg,jpeg,png}', { eager: true, import: 'default' }),
  'fitness-center': import.meta.glob<ImageMetadata>('../../assets/amenities/fitness-center/*.{jpg,jpeg,png}', { eager: true, import: 'default' }),
  kidsroom: import.meta.glob<ImageMetadata>('../../assets/amenities/kidsroom/*.{jpg,jpeg,png}', { eager: true, import: 'default' }),
  'pet-zone': import.meta.glob<ImageMetadata>('../../assets/amenities/pet-zone/*.{jpg,jpeg,png}', { eager: true, import: 'default' }),
} as const;

/* Sorted by filename, numerically, so `-2` precedes `-10` when the set grows
   and the order is the same on every machine — glob key order is not a
   guarantee worth relying on for something the visitor sees. */
const imagesFor = (id: string): ImageMetadata[] =>
  Object.entries(folders[id as keyof typeof folders] ?? {})
    .sort(([a], [b]) => a.localeCompare(b, 'en', { numeric: true }))
    .map(([, img]) => img);

export function getStaticPaths() {
  return localeStaticPaths();
}

const locale = localeFromParam(Astro.params?.lang);
const c = amenitiesCopy[locale];

/* Photography is locale-independent and matched to translated copy by id. */
const stack = c.stack.map((item) => ({ ...item, images: imagesFor(item.id) }));

/* A card with no photograph would render as a bare navy panel. Fail the build
   instead: a missing folder is a content error, not something to ship. */
const empty = stack.filter((s) => s.images.length === 0).map((s) => s.id);
if (empty.length) {
  throw new Error(`Amenity stack has no images for: ${empty.join(', ')}`);
}
---


<Base
  title={c.metaTitle}
  description={c.metaDescription}
  locale={locale}
  path="amenities"
>
  <section class="page-head" aria-labelledby="page-heading">
    <div class="shell shell--narrow page-head__inner">
      <p class="eyebrow" data-reveal="fade">{c.eyebrow}</p>
      <h1 class="display page-head__title" id="page-heading" data-reveal>
        {c.title}
      </h1>
      <hr class="page-head__rule" data-reveal="fade" />
      <p class="prose page-head__lede" data-reveal data-reveal-delay="0.08">{c.lede}</p>
    </div>
  </section>

  {/* The full schedule, set as a spec sheet rather than a bulleted brochure —
      these are the facts a broker reads down before calling. */}
  <section class="section section--dark schedule" aria-labelledby="schedule-heading">
    <div class="shell">
      <h2 class="heading schedule__title" id="schedule-heading" data-reveal>
        {c.scheduleTitle}
      </h2>
      <ul class="schedule__list" data-reveal>
        {c.schedule.map((item) => <li class="schedule__item">{item}</li>)}
      </ul>
    </div>
  </section>

  {/* Edge-to-edge cards that shuffle, each backed by a Ken Burns slideshow of
      that amenity's photography — the same sticky mechanic as the homepage
      deck. This replaced the alternating image/copy rows. */}
  <AmenityStack items={stack} />

  <PresentationCTA locale={locale} />

  {/* Every page carries the form at its foot so the Inquire and Schedule
      Private Presentation controls always have somewhere on-page to land. */}
  <section class="section section--alt" id="inquire" aria-labelledby="inquire-heading">
    <div class="shell">
      <InquiryForm locale={locale} variant="compact" headingId="inquire-heading" />
    </div>
  </section>
</Base>

<style>


  /* --- Schedule of amenities --------------------------------------------- */

  /* No background here on purpose: `.section--dark` in tokens.css supplies both
     the navy ground and --ink-on-dark, exactly as it does for PresentationCTA.
     A scoped `.schedule { background: … }` would carry Astro's cid attribute
     and so out-specify the shared modifier, silently winning. */

  .schedule__title { margin-bottom: var(--s-6); }

  /* Multi-column so the list still reads top-to-bottom in each column. */
  .schedule__list {
    columns: 3;
    column-gap: clamp(var(--s-5), 4vw, var(--s-8));
    /* --rule is 16% navy: invisible on a navy ground. The on-dark value is the
       same gesture inverted. */
    border-top: 1px solid var(--rule-on-dark);
  }

  .schedule__item {
    break-inside: avoid;
    padding-block: var(--s-3);
    border-bottom: 1px solid var(--rule-on-dark);
    font-size: var(--t-small);
    font-weight: var(--w-light);
    letter-spacing: var(--track-body);
    line-height: 1.6;
    text-transform: uppercase;
  }

  /* The featured amenities are a stacking deck now — see AmenityStack.astro.
     Its rules live there; nothing about them belongs to this page. */

  @media (max-width: 1024px) {
    .schedule__list { columns: 2; }
  }

  @media (max-width: 560px) {
    .schedule__list { columns: 1; }
  }
</style>
