---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PresentationCTA from '../../components/PresentationCTA.astro';
import InquiryForm from '../../components/InquiryForm.astro';
import { localeStaticPaths, localeFromParam } from '../../i18n/ui';
import { teamCopy } from '../../content/pages/the-team';

import vdaPortrait from '../../assets/team/vda-portrait.jpg';
import revueltaPortrait from '../../assets/team/revuelta-portrait.jpg';
import artefactoPortrait from '../../assets/team/artefacto-portrait.jpg';
import guilhemPortrait from '../../assets/team/carla-guilhem-portrait.jpg';
import cerveraPortrait from '../../assets/team/cervera-portrait.jpg';

export function getStaticPaths() {
  return localeStaticPaths();
}

const locale = localeFromParam(Astro.params?.lang);
const c = teamCopy[locale];

/**
 * Firm names, outbound links and portraits never translate, so they stay here
 * and are matched to the translated copy by id.
 *
 * The portraits are the published ones, but the site names no individuals
 * inside them — so neither does this page. Firms only; no bios, no titles.
 */
const firms: Record<string, { name: string; href: string; image: ImageMetadata }> = {
  vda: { name: 'VDA', href: 'https://vdaoriginmiami.com/', image: vdaPortrait },
  revuelta: {
    name: 'Revuelta Architecture International',
    href: 'https://revuelta.com/',
    image: revueltaPortrait,
  },
  artefacto: { name: 'Artefacto', href: 'https://artefacto.com/', image: artefactoPortrait },
  'carla-guilhem': {
    name: 'Carla Guilhem Design',
    href: 'https://carlaguilhem.com/',
    image: guilhemPortrait,
  },
  cervera: { name: 'Cervera', href: 'https://cervera.com/', image: cerveraPortrait },
};

/* The five partner firms, in the incumbent page's own order, with its own
   paragraphs and outbound links. Roles use the footer's credit vocabulary. */
const partners = c.partners.map((p) => ({ ...p, ...firms[p.id] }));
---

<Base
  title={c.metaTitle}
  description={c.metaDescription}
  locale={locale}
  path="the-team"
  darkHeader
>
  <section class="titleband" aria-labelledby="page-heading">
    <div class="shell titleband__inner">
      <p class="eyebrow">{c.eyebrow}</p>
      <h1 class="display titleband__headline" id="page-heading">{c.title}</h1>
      <hr class="titleband__rule" />
    </div>
  </section>

  <div class="section partners">
    <div class="shell partners__list">
      {partners.map((p, i) => (
        <article class:list={['partner', { 'partner--flip': i % 2 === 1 }]}>
          <figure class="partner__figure" data-reveal="fade">
            <Image
              src={p.image}
              alt={p.alt}
              widths={[352, 528, 704]}
              sizes="(max-width: 900px) 100vw, 40vw"
              loading={i === 0 ? 'eager' : 'lazy'}
            />
          </figure>

          <div class="partner__copy" data-reveal>
            <p class="eyebrow">{p.role}</p>
            <h2 class="heading partner__name">{p.name}</h2>
            <hr class="partner__rule" />
            <p class="prose partner__body">{p.body}</p>
            <a class="partner__link" href={p.href} target="_blank" rel="noopener noreferrer">
              <span>{c.visitWebsite}</span>
              <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" fill="none"
                   stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
                <path d="M7 7h10v10" /><path d="M7 17 17 7" />
              </svg>
              <span class="visually-hidden">{c.newTabNote}</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>

  <PresentationCTA locale={locale} />

  <section class="section section--alt" id="inquire" aria-labelledby="inquire-heading">
    <div class="shell">
      <InquiryForm locale={locale} variant="full" headingId="inquire-heading" />
    </div>
  </section>
</Base>

<style>
  /* --- Page title band ---------------------------------------------------- */
  .titleband {
    background: var(--navy);
    color: var(--ink-on-dark);
    padding-block: calc(var(--header-h) + var(--s-8)) var(--s-8);
  }

  .titleband__inner { display: grid; gap: var(--s-5); }

  .titleband__headline { color: var(--off-white); }

  .titleband__rule {
    width: clamp(64px, 8vw, 120px);
    height: 1px;
    border: 0;
    background: var(--gold);
  }

  /* --- Partner rows --------------------------------------------------------
     Alternating sides, separated by hairlines rather than cards — the credits
     are a document, not a directory of tiles. */
  .partners__list { display: grid; gap: clamp(var(--s-7), 6vw, var(--s-9)); }

  .partner {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(var(--s-5), 4vw, var(--s-8));
    align-items: center;
    padding-top: clamp(var(--s-6), 5vw, var(--s-8));
    border-top: 1px solid var(--rule);
  }

  .partner:first-child { padding-top: 0; border-top: 0; }

  .partner--flip .partner__figure { order: 2; }

  .partner__figure { margin: 0; }

  .partner__copy { display: grid; gap: var(--s-3); align-content: start; }

  .partner__name { color: var(--ink); }

  .partner__rule {
    width: clamp(40px, 5vw, 72px);
    height: 1px;
    border: 0;
    background: var(--gold);
    margin-block: var(--s-2);
  }

  .partner__body { color: var(--ink); }

  .partner__link {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    align-self: start;
    min-height: 44px;
    margin-top: var(--s-2);
    padding-block: var(--s-2);
    font-size: var(--t-micro);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--gold-ink);
    border-bottom: 1px solid var(--rule);
    transition: color var(--dur-fast) var(--ease-out),
                border-color var(--dur-fast) var(--ease-out);
  }
  .partner__link:hover { color: var(--ink); border-color: var(--navy); }
  .partner__link svg { transition: transform var(--dur-base) var(--ease-out); }
  .partner__link:hover svg { transform: translate(3px, -3px); }

  @media (max-width: 900px) {
    .partner { grid-template-columns: 1fr; align-items: start; }
    .partner--flip .partner__figure { order: 0; }
  }
</style>
