---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageBand from '../../components/PageBand.astro';
import ScheduleForm from '../../components/ScheduleForm.astro';
import { useTranslations, localeStaticPaths, localeFromParam } from '../../i18n/ui';
import { getCopy } from '../../content/copy';
import { scheduleCopy } from '../../content/pages/schedule-virtual-tour';
import facade from '../../assets/schedule/origin-waterfront-facade-dusk.jpg';
import { ADDRESS, MAP_HREF, PHONE, PHONE_HREF } from '../../data/contact';

export function getStaticPaths() {
  return localeStaticPaths();
}

const locale = localeFromParam(Astro.params?.lang);
const t = useTranslations(locale);
const c = getCopy(locale);
const s = scheduleCopy[locale];

const EMAIL = 'germanr.realty@gmail.com';
---

<Base
  title={s.metaTitle}
  description={c.home.presentationBody}
  locale={locale}
  path="schedule-virtual-tour"
  darkHeader
>
  <PageBand
    image={facade}
    alt={s.heroAlt}
    title={c.home.presentationTitle}
    lede={c.home.presentationBody}
    headingId="schedule-hero-heading"
  />

  <section class="section section--alt" aria-labelledby="schedule-heading">
    <div class="shell">
      <ul class="facts" data-reveal-group>
        <li class="fact">
          <h2 class="fact__label">{s.salesGallery}</h2>
          <a class="fact__value" href={MAP_HREF} target="_blank" rel="noopener noreferrer">{ADDRESS}</a>
        </li>
        <li class="fact">
          <h2 class="fact__label">{t('call')}</h2>
          <a class="fact__value" href={PHONE_HREF}>{PHONE}</a>
        </li>
        <li class="fact">
          <h2 class="fact__label">{t('email')}</h2>
          <a class="fact__value" href={`mailto:${EMAIL}`}>{EMAIL}</a>
        </li>
      </ul>

      <hr class="rule facts__rule" />

      <ScheduleForm locale={locale} headingId="schedule-heading" />
    </div>
  </section>
</Base>

<style>

  /* The hero and its scrim live in PageBand.astro now. */

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--s-6);
  }

  .fact { display: grid; gap: var(--s-2); align-content: start; }

  .fact__label {
    font-size: var(--t-micro);
    font-weight: var(--w-light);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    /* Gold is a rule-and-border colour on light grounds: as text it is 2.4:1
       here. Darkened against --navy-deep it keeps the accent and clears AA. */
    color: var(--gold-ink, color-mix(in srgb, var(--gold) 52%, var(--navy-deep)));
  }

  .fact__value {
    font-size: var(--t-small);
    line-height: 1.8;
    color: var(--ink);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .fact__value:hover { color: var(--gold-ink); }

  .facts__rule { margin-block: clamp(var(--s-7), 5vw, var(--s-8)); }
</style>
