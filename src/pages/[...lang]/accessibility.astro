---
import Base from '../../layouts/Base.astro';
import PageBand from '../../components/PageBand.astro';
import { BAND_PLACEHOLDER, BAND_PLACEHOLDER_ALT } from '../../data/band-art';
import InquiryForm from '../../components/InquiryForm.astro';
import { useTranslations, localizePath, localeStaticPaths, localeFromParam } from '../../i18n/ui';
import { legalCopy, legalBody } from '../../content/pages/legal';
import { ADDRESS, PHONE, PHONE_HREF } from '../../data/contact';

/* The incumbent site publishes an Accessibility page, so the commitment is an
   existing public one. This statement describes only what this build actually
   does — every line below is verifiable on the pages themselves.

   The statement is published in ENGLISH on every locale, alongside the other
   two legal notices — see the note at the head of src/content/pages/legal.ts.
   Only the title, meta, the English-text notice and the cross-references are
   translated. */

export function getStaticPaths() {
  return localeStaticPaths();
}

const locale = localeFromParam(Astro.params?.lang);
const t = useTranslations(locale);
const L = (p: string) => localizePath(p, locale);

/* BCP47 casing for the lang attribute on the translated cross-references. */
const htmlLang = locale === 'pt-br' ? 'pt-BR' : locale;

const chrome = legalCopy[locale];
const c = chrome.accessibility;
const body = legalBody.accessibility;

const EMAIL = 'germanr.realty@gmail.com';
---

<Base
  title={c.metaTitle}
  description={c.metaDescription}
  locale={locale}
  path="accessibility"
>
  {/* PLACEHOLDER artwork — see src/data/band-art.ts. */}
  <PageBand
    image={BAND_PLACEHOLDER}
    alt={BAND_PLACEHOLDER_ALT[locale]}
    eyebrow={c.eyebrow}
    title={c.title}
  >
    {chrome.englishNote && <p class="band__note">{chrome.englishNote}</p>}
  </PageBand>

  <div class="section legal">
    <div class="shell shell--narrow legal__inner" lang="en">
      <p class="legal__lede" data-reveal>{body.lede}</p>

      <section class="legal__section" aria-labelledby="a11y-standard" data-reveal>
        <h2 class="subheading" id="a11y-standard">{body.standardTitle}</h2>
        <p class="prose">{body.standardBody}</p>
      </section>

      <section class="legal__section" aria-labelledby="a11y-measures" data-reveal>
        <h2 class="subheading" id="a11y-measures">{body.measuresTitle}</h2>
        <ul class="legal__list">
          {body.measures.map((line) => <li>{line}</li>)}
        </ul>
      </section>

      <section class="legal__section" aria-labelledby="a11y-ongoing" data-reveal>
        <h2 class="subheading" id="a11y-ongoing">{body.ongoingTitle}</h2>
        <p class="prose">{body.ongoingBody}</p>
      </section>

      <section class="legal__section" aria-labelledby="a11y-feedback" data-reveal>
        <h2 class="subheading" id="a11y-feedback">{body.feedbackTitle}</h2>
        <p class="prose">{body.feedbackBody}</p>
        <p class="prose">
          {body.contactBeforeEmail}<a href={`mailto:${EMAIL}`}>{EMAIL}</a>{
            body.contactBetweenEmailPhone
          }<a href={PHONE_HREF}>{PHONE}</a>{body.contactBetweenPhoneAddress}{ADDRESS}{
            body.contactAfterAddress
          }<a href={L('schedule-virtual-tour')} lang={htmlLang}>{t('schedule')}</a>{
            body.contactAfterSchedule
          }
        </p>
        {/* Cross-references are navigation, so they follow the reader's
            language even though the statement itself does not. */}
        <p class="prose" lang={htmlLang}>
          {c.seeAlso.lead}<a href={L('privacy-policy')}>{t('privacy')}</a>{c.seeAlso.join}<a
            href={L('terms-of-use')}>{t('terms')}</a>{c.seeAlso.tail}
        </p>
      </section>
    </div>
  </div>

  {/* Every page carries the form at its foot so the Inquire and Schedule
      Private Presentation controls always have somewhere on-page to land. */}
  <section class="section section--alt" id="inquire" aria-labelledby="inquire-heading">
    <div class="shell">
      <InquiryForm locale={locale} variant="compact" headingId="inquire-heading" />
    </div>
  </section>
</Base>

<style>
  /* Slotted into PageBand, on the dark veil. */
  .band__note {
    max-width: var(--measure);
    margin-top: var(--s-3);
    font-size: var(--t-small);
    font-weight: var(--w-light);
    line-height: 1.8;
    color: var(--ink-on-dark-muted);
  }


  /* The shared eyebrow is gold, which is 2.1:1 on this sand ground. Darkened
     against --navy-deep it holds the accent and clears AA. */
  .eyebrow {
    color: var(--gold-ink, color-mix(in srgb, var(--gold) 52%, var(--navy-deep)));
  }

  /* Only rendered on es and pt-br: the statement below is published in English. */

  .legal { background: var(--ground-alt); }

  .legal__inner { display: grid; gap: clamp(var(--s-6), 4vw, var(--s-8)); }

  .legal__lede {
    max-width: var(--measure);
    font-size: var(--t-h4);
    font-weight: var(--w-light);
    line-height: 1.85;
  }

  .legal__section { display: grid; gap: var(--s-4); }

  .legal__list {
    display: grid;
    gap: var(--s-3);
    max-width: var(--measure);
  }

  .legal__list li {
    padding-left: var(--s-5);
    font-size: var(--t-small);
    line-height: 1.8;
    border-left: 1px solid var(--rule);
  }

  .legal a {
    color: var(--ink);
    border-bottom: 1px solid var(--rule);
    overflow-wrap: anywhere;
    transition: color var(--dur-fast) var(--ease-out),
                border-color var(--dur-fast) var(--ease-out);
  }
  .legal a:hover { color: var(--gold-ink); border-bottom-color: var(--gold); }
</style>
