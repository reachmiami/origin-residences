---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ListingGrid from '../../components/ListingGrid.astro';
import InquiryForm from '../../components/InquiryForm.astro';
import FeatureBand from '../../components/FeatureBand.astro';
import KenBurns from '../../components/KenBurns.astro';

import slidingGlass from '../../assets/residences/sliding-glass-living-bay-view.jpg';
import greatRoomGlass from '../../assets/residences/great-room-kitchen-through-glass.jpg';
import bedroomBay from '../../assets/residences/primary-bedroom-bay-view.jpg';
import bathShower from '../../assets/residences/bathroom-shower-double-vanity.jpg';
import balconyBleed from '../../assets/residences/balcony-full-bleed.jpg';
import modernBath from '../../assets/residences/modern-bathroom-cabinetry.jpg';
import { localeStaticPaths, localeFromParam } from '../../i18n/ui';
import { getCopy } from '../../content/copy';
import { residencesCopy } from '../../content/pages/residences';
import { unitCount } from '../../data/units';

export function getStaticPaths() {
  return localeStaticPaths();
}

const locale = localeFromParam(Astro.params?.lang);
const c = getCopy(locale);
const r = residencesCopy[locale];

/* The RESIDENCES FEATURES list, in the incumbent's published order. */
const features = r.features;

/* Written out rather than computed — 0.08 + 0.06 is 0.14000000000000001 in
   binary floating point, and that lands in the attribute verbatim. */
const ledeDelays = ['0.08', '0.14'];

/* The residence-features slideshow.
   ---------------------------------------------------------------------------
   Globbed rather than imported one by one, the same arrangement the amenity
   cards use: dropping a photograph into the folder puts it into the rotation
   with no code change. Sorted by filename, numerically, so the order is the
   same on every machine — glob key order is not a guarantee worth showing a
   visitor.

   Only the LEAD slide is described. The rest are the same rooms from other
   angles, and narrating thirteen renderings of one apartment is noise; this is
   the convention KenBurns.astro documents and the amenity cards already
   follow. */
const featureArt: ImageMetadata[] = Object.entries(
  import.meta.glob<ImageMetadata>('../../assets/residences/features/*.{jpg,jpeg,png}', {
    eager: true,
    import: 'default',
  }),
)
  .sort(([a], [b]) => a.localeCompare(b, 'en', { numeric: true }))
  .map(([, img]) => img);

/* Artwork is locale-independent and matched to translated copy by id, the same
   way the homepage bands do it. */
const bandArt: Record<string, ImageMetadata[]> = {
  'sliding-glass': [slidingGlass, greatRoomGlass, bedroomBay],
  'modern-bathrooms': [modernBath, bathShower],
};

/* Pair each slide with its own alt text, in order. */
const slidesFor = (band: (typeof r.bands)[number]) =>
  (bandArt[band.id] ?? []).map((src, i) => ({ src, alt: band.alts[i] ?? band.alts[0] ?? '' }));
---

<Base
  title={r.metaTitle}
  description={r.metaDescription(unitCount)}
  locale={locale}
  path="residences"
>
  {/* A type-set page head, as Amenities and the other interior pages have,
      rather than the photographic band this page used to open with. It absorbs
      what was a separate "Discover your dream home" section below the band —
      that section carried this exact heading and these exact paragraphs, so
      leaving it in place would have printed both twice.

      The floor-plan range that briefly sat here has moved down to the
      inventory grid, where it describes the cards it sits above rather than
      the page as a whole. */}
  <section class="page-head" aria-labelledby="page-heading">
    <div class="shell shell--narrow page-head__inner">
      <p class="eyebrow" data-reveal="fade">{r.title}</p>

      <h1 class="display page-head__title" id="page-heading" data-reveal>
        {r.discoverTitle}
      </h1>

      <hr class="page-head__rule" data-reveal="fade" />

      {/* Two paragraphs, so two <p>s — they cannot share one, and each carries
          the lede class so both read at lede weight. */}
      {r.discoverParagraphs.map((para, n) => (
        <p class="prose page-head__lede" data-reveal data-reveal-delay={ledeDelays[n] ?? '0.14'}>
          {para}
        </p>
      ))}

    </div>
  </section>

  <ListingGrid locale={locale} />

  {/* The features, set over the photography rather than beside one frame of
      it. Same Ken Burns slideshow the amenity cards carry — and the same scrim
      discipline, because the type has to hold against the LIGHTEST moment of
      any slide, not against an average.

      This is not a stacking deck: it is one band, so it does not take
      AmenityStack's sticky geometry. If a third full-bleed Ken Burns section
      appears, the scrim and the centred body are what to extract. */}
  <section class="features" aria-labelledby="features-heading">
    <KenBurns images={featureArt} alt={c.home.fullBleedAlt} interval={6} />
    <div class="features__scrim" aria-hidden="true"></div>

    <div class="shell shell--narrow features__body">
      <h2 class="heading features__title" id="features-heading" data-reveal>
        {r.featuresTitle}
      </h2>
      <hr class="rule features__rule" data-reveal="fade" />
      <ul class="features__list" data-reveal-group>
        {features.map((item) => <li class="features__item">{item}</li>)}
      </ul>
    </div>
  </section>

  {r.bands[0] && (
    <FeatureBand
      id={r.bands[0].id}
      lines={r.bands[0].lines}
      images={slidesFor(r.bands[0])}
      locale={locale}
      flip={r.bands[0].flip}
      align={r.bands[0].align}
      emphasisFrom={r.bands[0].emphasisFrom}
    />
  )}

  {/* Centred statement between the two bands. Dark ground for the same reason
      the homepage options band is dark: the page otherwise runs sand-on-sand. */}
  <section class="section statement" aria-labelledby="statement-heading">
    <div class="shell shell--narrow statement__inner">
      <h2 class="subheading statement__lede" id="statement-heading" data-reveal>
        {r.statementLines.map((line) => <span class="statement__line">{line}</span>)}
      </h2>
    </div>
  </section>

  <section class="fullbleed" aria-label={r.fullBleedAlt}>
    <Image
      class="fullbleed__img"
      src={balconyBleed}
      alt={r.fullBleedAlt}
      layout="full-width"
      widths={[640, 1024, 1600, 1920]}
      sizes="100vw"
      loading="lazy"
    />
  </section>

  {r.bands[1] && (
    <FeatureBand
      id={r.bands[1].id}
      lines={r.bands[1].lines}
      images={slidesFor(r.bands[1])}
      locale={locale}
      flip={r.bands[1].flip}
      align={r.bands[1].align}
      emphasisFrom={r.bands[1].emphasisFrom}
    />
  )}

  <section class="section section--alt" id="inquire" aria-labelledby="residences-inquire">
    <div class="shell">
      <InquiryForm locale={locale} variant="compact" headingId="residences-inquire" />
    </div>
  </section>
</Base>

<style>
  /* The page band now lives in PageBand.astro, shared with every other titled
     page. Its clearance for the fixed transparent header travels with it. */

  /* --- Discover -------------------------------------------------------------- */




  /* --- Features -------------------------------------------------------------- */

  .features {
    position: relative;
    display: grid;
    place-items: center;
    /* Exactly the window below the header, so the band meets the bar at the
       top and the viewport edge at the bottom with nothing showing past it.

       `min-height`, not `height`, and `svh`, not `vh`: svh keeps mobile
       browser chrome from cropping the band, and a minimum lets the section
       grow rather than clip if the list ever outgrows the window — Spanish
       already wraps two of these lines, and a short laptop viewport is the
       case where a fixed height would cut the last feature off. When the copy
       fits, which is every viewport measured, min-height and height render
       identically. */
    min-height: calc(100svh - var(--header-h));
    padding-block: var(--s-7);
    overflow: clip;
    /* Opaque ground so the band is never a light gap while a slide decodes. */
    background: var(--navy);
    /* Contains the scrim's stacking so nothing below can paint between the
       photograph and the type. */
    isolation: isolate;
  }

  .features__scrim {
    position: absolute;
    inset: 0;
    /* Above the drifting slideshow, below the type. */
    z-index: 1;
    pointer-events: none;
    /* Two layers, for the reason AmenityStack documents at length: the pool
       seats the type, and the flat veil under it carries the worst case,
       because the pool's falloff is sized to the copy and the copy is not the
       same height in every language. FOURTEEN slides here, ungraded together —
       a sunlit terrace and a dark panelled bedroom in one rotation — so the
       list has to hold against the brightest moment of any of them, not
       against their average.

       Measured with measure-residence-features.mjs, which forces every slide
       active in turn across three languages and four viewports:

         no scrim tuning (58/34 over 30%)  3.62:1  — fails AA
         62/44 over 44%                    6.47:1  — passes, greys the rooms
         52/34 over 34%                    4.38:1  — fails, and several
                                                     viewports sat on 4.4
         56/38 over 38%                    5.16:1  — chosen

       The rejected 6.47 is the trap AmenityStack names: contrast bought past
       the threshold is paid for out of the photograph, and the photography is
       the product here.

       CURRENT WORST: 4.84:1, pt phone 375. Tightening the spacing for short
       windows (see the max-height block below) moved the copy further into the
       pool's falloff and cost about 0.3 — measured, not estimated. Still clear
       of AA, but the margin is thinner than it reads above, so re-run the
       script after touching either the scrim OR the spacing; on this band they
       are the same control. */
    background:
      radial-gradient(
        ellipse 96% 84% at 50% 50%,
        color-mix(in srgb, var(--navy-deep) 56%, transparent) 0%,
        color-mix(in srgb, var(--navy-deep) 38%, transparent) 68%,
        transparent 100%
      ),
      color-mix(in srgb, var(--navy-deep) 38%, transparent);
  }

  .features__body {
    position: relative;
    /* Above the scrim. */
    z-index: 2;
    display: grid;
    justify-items: center;
    gap: var(--s-5);
    text-align: center;
  }

  .features__title { color: var(--ink-on-dark); }

  .features__rule {
    width: 120px;
    max-width: 120px;
    margin: 0;
    background: var(--gold);
  }

  .features__list {
    display: grid;
    gap: var(--s-3);
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .features__item {
    padding-bottom: var(--s-3);
    border-bottom: 1px solid var(--rule-on-dark);
    color: var(--ink-on-dark);
    font-size: var(--t-small);
    font-weight: var(--w-light);
    letter-spacing: var(--track-body);
  }

  /* The last line needs no rule under it — there is nothing to separate it
     from, and the band's lower edge already closes the list. */
  .features__item:last-child { border-bottom: 0; padding-bottom: 0; }

  /* Short windows.
     -------------------------------------------------------------------------
     Eleven lines of copy in a 724px window is the case where the band would
     otherwise outgrow the space it is supposed to fill exactly. Measured, at
     the padding above: a phone needed 771px of the 724 available in English
     and 847 in Spanish, which wraps two of these lines onto a second row.

     Tightening the padding and the space between features recovers that —
     phone now fills exactly in both languages. A genuinely short desktop
     window (620px tall) still cannot hold the list; there the band grows
     rather than clipping, which is the trade `min-height` above exists to
     make. Shrinking the type to force a fit would cost more than the gap. */
  @media (max-height: 860px) {
    .features { padding-block: var(--s-5); }
    .features__list { gap: var(--s-2); }
    .features__item { padding-bottom: var(--s-2); }
  }

  /* --- Statement band ------------------------------------------------------ */

  .statement {
    background: var(--ground-dark);
    color: var(--ink-on-dark);
  }

  .statement__inner { display: grid; justify-items: center; text-align: center; }

  .statement__lede {
    display: grid;
    gap: 0.15em;
    color: var(--off-white);
  }

  /* --- Closing frame ------------------------------------------------------- */

  .fullbleed { background: var(--navy); font-size: 0; }
  .fullbleed__img { width: 100%; height: auto; }
</style>
