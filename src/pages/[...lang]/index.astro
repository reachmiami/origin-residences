---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import PresentationCTA from '../../components/PresentationCTA.astro';
import InquiryForm from '../../components/InquiryForm.astro';
import { localeStaticPaths, localeFromParam, localizePath } from '../../i18n/ui';
import { getCopy } from '../../content/copy';
import { homeCopy } from '../../content/pages/home';

import bespokeDesign from '../../assets/home/bespoke-design-living-dining.jpg';
import livingConcept from '../../assets/home/living-concept-building-waterfront.jpg';
import naturalBeauty from '../../assets/home/natural-beauty-artefacto-lounge.jpg';
import greatRoom from '../../assets/home/great-room-full-bleed.jpg';

export function getStaticPaths() {
  return localeStaticPaths();
}

const locale = localeFromParam(Astro.params?.lang);
const c = getCopy(locale);
const meta = homeCopy[locale];
const L = (p: string) => localizePath(p, locale);

/* Artwork is locale-independent and matched to translated copy by id, the same
   way the amenities page does it. */
const artwork: Record<string, ImageMetadata> = {
  'bespoke-design': bespokeDesign,
  'living-concept': livingConcept,
  'natural-beauty': naturalBeauty,
};

/* The incumbent alternates a solid colour panel against a full-bleed image:
   sand/image, image/grey, sand/image. `flip` puts the image on the left. */
const bands = c.home.features.map((f, i) => ({
  ...f,
  image: artwork[f.id],
  flip: i % 2 === 1,
  tone: i % 2 === 1 ? 'grey' : 'sand',
}));
---

<Base
  title={meta.metaTitle}
  description={meta.metaDescription}
  locale={locale}
  path=""
  darkHeader
>
  <Hero locale={locale} />

  <section class="section intro" aria-labelledby="intro-heading">
    <div class="shell shell--narrow intro__inner">
      <h2 class="subheading intro__lede" id="intro-heading" data-reveal>
        {c.home.collabLine1}<br />
        {c.home.collabLine2}<br />
        {c.home.collabLine3}
      </h2>
      <hr class="rule intro__rule" data-reveal="fade" />
      <p class="prose intro__body" data-reveal data-reveal-delay="0.1">{c.home.intro}</p>
    </div>
  </section>

  {/* The incumbent's plan-options band: a quiet centred statement carrying the
      one action, in place of the full inventory listing that stood here. */}
  <section class="section options" aria-labelledby="options-heading">
    <div class="shell shell--narrow options__inner">
      <h2 class="subheading options__lede" id="options-heading" data-reveal>
        {c.home.inventoryLede}
      </h2>
      <p class="eyebrow options__limited" data-reveal data-reveal-delay="0.06">
        {c.home.inventoryLimited}
      </p>
      <a class="btn btn--outline" href={L('residences')} data-reveal data-reveal-delay="0.12">
        <span>{c.home.inventoryCta}</span>
        <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" fill="none"
             stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
          <path d="M7 7h10v10" /><path d="M7 17 17 7" />
        </svg>
      </a>
    </div>
  </section>

  {bands.map((band) => (
    <section
      class:list={[
        'feature',
        band.tone === 'sand' ? 'feature--alt' : 'feature--grey',
        { 'feature--flip': band.flip },
      ]}
      id={band.id}
      aria-labelledby={`${band.id}-heading`}
    >
      <div class="feature__inner">
        <figure class="feature__figure" data-reveal="fade">
          <Image
            class="feature__img"
            src={band.image}
            alt={band.alt}
            widths={[640, 1024, 1440]}
            sizes="(max-width: 860px) 100vw, 50vw"
            loading="lazy"
          />
        </figure>

        <div class="feature__panel">
          <div class="feature__body">
            <h2 class="feature__title" id={`${band.id}-heading`} data-reveal>
              {band.lines.map((line) => <span class="feature__line">{line}</span>)}
              {band.sub && <span class="feature__sub">{band.sub}</span>}
            </h2>
            <hr class="feature__rule" data-reveal="fade" />
          </div>
        </div>
      </div>
    </section>
  ))}

  <PresentationCTA locale={locale} />

  {/* Closing full-bleed frame — no panel, the room carries it. */}
  <section class="fullbleed" aria-label={c.home.fullBleedAlt}>
    <Image
      class="fullbleed__img"
      src={greatRoom}
      alt={c.home.fullBleedAlt}
      layout="full-width"
      widths={[640, 1024, 1600, 1920]}
      sizes="100vw"
      loading="lazy"
    />
  </section>

  <section class="section section--alt" id="inquire" aria-labelledby="inquire-heading">
    <div class="shell">
      <InquiryForm locale={locale} variant="full" headingId="inquire-heading" />
    </div>
  </section>
</Base>

<style>
  .intro { background: var(--ground); }

  .intro__inner {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: var(--s-6);
  }

  .intro__lede { color: var(--ink); }
  .intro__rule { max-width: 120px; background: var(--gold); }
  .intro__body { color: var(--ink); }

  /* --- Plan options ------------------------------------------------------- */

  /* Dark ground here deliberately: the page runs sand-on-sand through the
     intro and the bands, and this band breaks that up. Type sizes unchanged. */
  .options {
    background: var(--ground-dark);
    color: var(--ink-on-dark);
  }

  .options__inner {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: var(--s-5);
  }

  .options__lede {
    max-width: 30ch;
    color: var(--off-white);
  }

  /* Gold reads 5.59:1 on navy, so the accent returns to the brand value. */
  .options__limited { color: var(--gold); }

  .btn--outline {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    margin-top: var(--s-2);
    padding: var(--s-4) var(--s-7);
    border: 1px solid var(--gold);
    color: var(--gold);
    font-size: var(--t-micro);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    transition: background var(--dur-base) var(--ease-out),
                color var(--dur-base) var(--ease-out);
  }
  .btn--outline:hover { background: var(--gold); color: var(--navy); }
  .btn--outline svg { transition: transform var(--dur-base) var(--ease-out); }
  .btn--outline:hover svg { transform: translate(3px, -3px); }

  /* --- Alternating bands --------------------------------------------------
     Edge to edge, half colour panel and half photograph, mirroring the
     incumbent. Same alt/flip vocabulary as the amenities page.              */

  .feature { scroll-margin-top: var(--header-h); }

  .feature__inner {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: stretch;
    min-height: clamp(360px, 42vw, 560px);
  }

  /* Default is panel-left, image-right; flip swaps them. */
  .feature__figure { order: 2; margin: 0; }
  .feature__panel { order: 1; }
  .feature--flip .feature__figure { order: 1; }
  .feature--flip .feature__panel { order: 2; }

  .feature__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .feature--alt .feature__panel { background: var(--ground); }
  .feature--grey .feature__panel { background: var(--warm-gray); }

  .feature__panel {
    display: grid;
    align-items: center;
    padding: clamp(var(--s-6), 6vw, var(--s-10));
  }

  /* The panel's own column is indented from the outer edge so the type sits
     off the page margin rather than against it. */
  .feature__body {
    display: grid;
    justify-items: start;
    gap: var(--s-5);
    margin-inline: auto;
  }

  .feature--flip .feature__body { margin-inline: auto; }

  .feature__title {
    display: grid;
    gap: 0.1em;
    font-size: clamp(1.5rem, 1rem + 1.9vw, 2.6rem);
    font-weight: var(--w-thin);
    letter-spacing: var(--track-heading);
    line-height: 1.22;
    text-transform: uppercase;
    color: var(--ink);
  }

  .feature__line { white-space: nowrap; }

  /* The second line carries the weight the incumbent gives it. */
  .feature__line:nth-child(2) { font-weight: var(--w-light); }

  .feature__sub {
    justify-self: end;
    margin-top: 0.15em;
    font-size: 0.5em;
    letter-spacing: 0.02em;
    text-transform: none;
    color: var(--ink-muted);
  }

  .feature__rule {
    width: min(100%, 320px);
    height: 1px;
    border: 0;
    background: var(--rule);
  }

  /* On the grey panel the ink lightens to keep contrast. */
  .feature--grey .feature__title { color: var(--off-white); }
  .feature--grey .feature__sub { color: rgba(255, 253, 249, 0.8); }
  .feature--grey .feature__rule { background: rgba(255, 253, 249, 0.5); }

  /* --- Closing frame ------------------------------------------------------ */

  .fullbleed { background: var(--navy); font-size: 0; }
  .fullbleed__img { width: 100%; height: auto; }

  @media (max-width: 860px) {
    /* Stacked: image first on every band, so the rhythm stays predictable. */
    .feature__inner { grid-template-columns: 1fr; min-height: 0; }
    .feature__figure,
    .feature--flip .feature__figure { order: 1; }
    .feature__panel,
    .feature--flip .feature__panel { order: 2; }

    .feature__img { height: auto; aspect-ratio: 16 / 10; }
    .feature__body { margin-inline: 0; }
    .feature__line { white-space: normal; }
  }
</style>
