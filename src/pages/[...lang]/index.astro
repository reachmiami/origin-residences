---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import HomeHero from '../../components/HomeHero.astro';
import HomeStack from '../../components/HomeStack.astro';
import PresentationCTA from '../../components/PresentationCTA.astro';
import InquiryForm from '../../components/InquiryForm.astro';
import { localeStaticPaths, localeFromParam, localizePath } from '../../i18n/ui';
import { getCopy } from '../../content/copy';
import { homeCopy } from '../../content/pages/home';

import bespokeDesign from '../../assets/gallery/residence-living-dining-bay-view.jpg';
import livingConcept from '../../assets/gallery/residence-terrace-to-living.jpg';
import naturalBeauty from '../../assets/gallery/rooftop-deck-skyline.jpg';
import greatRoom from '../../assets/home/great-room-full-bleed.jpg';

export function getStaticPaths() {
  return localeStaticPaths();
}

/* The sunset hero with the flying logo. It was built as an alternate (`/v2/`)
   and shown to the client, who chose it; it is the homepage now, and the
   original video hero is retired in src/components/Hero.astro. */

const locale = localeFromParam(Astro.params?.lang);
const c = getCopy(locale);
const meta = homeCopy[locale];
const L = (p: string) => localizePath(p, locale);

/* Artwork is locale-independent and matched to translated copy by id, the same
   way the amenities page does it. */
const artwork: Record<string, ImageMetadata> = {
  'bespoke-design': bespokeDesign,
  'living-concept': livingConcept,
  'natural-beauty': naturalBeauty,
};

/* These three read as edge-to-edge cards that shuffle over one another, so
   there is no longer a colour panel to alternate or an image side to flip. */
const bands = c.home.features.map((f) => ({ ...f, image: artwork[f.id] }));
---

<Base
  title={meta.metaTitle}
  description={meta.metaDescription}
  locale={locale}
  path=""
  headerVariant="home"
>
  <HomeHero locale={locale} />

  <section class="section intro" aria-labelledby="intro-heading">
    <div class="shell shell--narrow intro__inner">
      <h2 class="subheading intro__lede" id="intro-heading" data-reveal>
        {c.home.collabLine1}<br />
        {c.home.collabLine2}<br />
        {c.home.collabLine3}
      </h2>
      <hr class="rule intro__rule" data-reveal="fade" />
      <p class="prose intro__body" data-reveal data-reveal-delay="0.1">{c.home.intro}</p>
    </div>
  </section>

  {/* The incumbent's plan-options band: a quiet centred statement carrying the
      one action, in place of the full inventory listing that stood here. */}
  <section class="section options" aria-labelledby="options-heading">
    <div class="shell shell--narrow options__inner">
      <h2 class="subheading options__lede" id="options-heading" data-reveal>
        {c.home.inventoryLede}
      </h2>
      <p class="eyebrow options__limited" data-reveal data-reveal-delay="0.06">
        {c.home.inventoryLimited}
      </p>
      <a class="btn btn--outline" href={L('residences')} data-reveal data-reveal-delay="0.12">
        <span>{c.home.inventoryCta}</span>
        <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" fill="none"
             stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
          <path d="M7 7h10v10" /><path d="M7 17 17 7" />
        </svg>
      </a>
    </div>
  </section>

  <HomeStack bands={bands} />

  <PresentationCTA locale={locale} />

  {/* Closing full-bleed frame — no panel, the room carries it. */}
  <section class="fullbleed" aria-label={c.home.fullBleedAlt}>
    <Image
      class="fullbleed__img"
      src={greatRoom}
      alt={c.home.fullBleedAlt}
      layout="full-width"
      widths={[640, 1024, 1600, 1920]}
      sizes="100vw"
      loading="lazy"
    />
  </section>

  <section class="section section--alt" id="inquire" aria-labelledby="inquire-heading">
    <div class="shell">
      <InquiryForm locale={locale} variant="full" headingId="inquire-heading" />
    </div>
  </section>
</Base>

<style>
  .intro { background: var(--ground); }

  .intro__inner {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: var(--s-6);
  }

  .intro__lede { color: var(--ink); }
  .intro__rule { max-width: 120px; background: var(--gold); }
  .intro__body { color: var(--ink); }

  /* --- Plan options ------------------------------------------------------- */

  /* Dark ground here deliberately: the page runs sand-on-sand through the
     intro and the bands, and this band breaks that up. Type sizes unchanged. */
  .options {
    background: var(--ground-dark);
    color: var(--ink-on-dark);
  }

  .options__inner {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: var(--s-5);
  }

  .options__lede {
    max-width: 30ch;
    color: var(--off-white);
  }

  /* Gold reads 5.59:1 on navy, so the accent returns to the brand value. */
  .options__limited { color: var(--gold); }

  .btn--outline {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    margin-top: var(--s-2);
    padding: var(--s-4) var(--s-7);
    border: 1px solid var(--gold);
    color: var(--gold);
    font-size: var(--t-micro);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    transition: background var(--dur-base) var(--ease-out),
                color var(--dur-base) var(--ease-out);
  }
  .btn--outline:hover { background: var(--gold); color: var(--navy); }
  .btn--outline svg { transition: transform var(--dur-base) var(--ease-out); }
  .btn--outline:hover svg { transform: translate(3px, -3px); }

  /* The three feature bands live in HomeStack.astro. */

  /* --- Closing frame ------------------------------------------------------ */

  .fullbleed { background: var(--navy); font-size: 0; }
  .fullbleed__img { width: 100%; height: auto; }
</style>
