---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PresentationCTA from '../../components/PresentationCTA.astro';
import InquiryForm from '../../components/InquiryForm.astro';
import { localeStaticPaths, localeFromParam } from '../../i18n/ui';
import { artefactoCopy } from '../../content/pages/artefacto';

import terrace from '../../assets/artefacto/terrace-lounge.jpg';
/* Both supplied as cut-outs on transparency, which is why they sit on the
   charcoal without a frame around them. */
import artefactoPortrait from '../../assets/team/artefacto-portrait-clipped.png';
import guilhemPortrait from '../../assets/team/carla-guilhem-portrait.png';
import livingRoom from '../../assets/artefacto/living-room-curved-sofa.jpg';
import lobby from '../../assets/artefacto/lobby-double-height.jpg';
import bedroom from '../../assets/artefacto/bedroom-with-balcony.jpg';
import kitchen from '../../assets/artefacto/kitchen-and-dining.jpg';
import openPlan from '../../assets/artefacto/open-plan-living.jpg';

export function getStaticPaths() {
  return localeStaticPaths();
}

const locale = localeFromParam(Astro.params?.lang);
const c = artefactoCopy[locale];
---

<Base
  title={c.metaTitle}
  description={c.metaDescription}
  locale={locale}
  path="artefacto"
  darkHeader
>
  {/* THE WHOLE PAGE RUNS DARK, on the charcoal the Team page already gives
      Artefacto — the two pages describe the same firm and now share its ground.

      It is done by re-pointing the ground and ink TOKENS on this wrapper rather
      than by restyling each section. `.page-head`, `.section--alt` and the rest
      read their colours from `--ground`, `--ground-alt`, `--ink` and `--rule`,
      so overriding those four here turns every section on the page at once and
      cannot reach a section on any other page: the class exists only in this
      file, and custom properties inherit downwards, never sideways.

      `--ground-dark` is deliberately NOT touched. The Bacchi quote band stands
      on it, the owner likes it as it is, and both quote bands now use it. */}
  <div class="dark-page">
    <section class="page-head" aria-labelledby="page-heading">
      <div class="shell shell--narrow page-head__inner">
        <p class="eyebrow" data-reveal="fade">{c.eyebrow}</p>
        <h1 class="display page-head__title" id="page-heading" data-reveal>{c.headline}</h1>
        <hr class="page-head__rule" data-reveal="fade" />
        <p class="prose page-head__lede" data-reveal data-reveal-delay="0.08">{c.headLede}</p>

        {/* The file is already cut to the crop it needs, so nothing here
            trims it — it runs at its own 922px on a full-size screen and only
            starts shrinking when the window is narrower than that. */}
        <figure class="portrait" data-reveal="fade" data-reveal-delay="0.14">
          <Image
            src={artefactoPortrait}
            alt={c.portraitAlt}
            widths={[460, 700, 922]}
            sizes="(max-width: 980px) 92vw, 922px"
            loading="lazy"
          />
        </figure>
      </div>
    </section>

    {/* The editorial opening now sits INSIDE the photograph rather than in a
        two-column block below it, centred over the terrace on the same radial
        gradient the homepage stack bands use. It does not stick or stack — it
        is one band that scrolls past like any other section. */}
    <figure class="band band--hero" aria-labelledby="editorial-heading">
      <Image
        src={terrace}
        alt={c.alt.terrace}
        widths={[640, 960, 1280, 1445]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
      <div class="band__scrim" aria-hidden="true"></div>

      <figcaption class="band__body">
        <h2 class="band__title" id="editorial-heading" data-reveal>{c.editorialTitle}</h2>
        <p class="band__lede" data-reveal data-reveal-delay="0.06">{c.lede}</p>
        <hr class="band__rule" data-reveal="fade" />
        <p class="band__text" data-reveal data-reveal-delay="0.12">{c.body}</p>
      </figcaption>
    </figure>

    {/* Asymmetric pair — the wider room leads, the lobby rides low beside it. */}
    <div class="section section--alt pair">
      {/* The two frames arrive from opposite directions — left from below,
          right from above — so the pair assembles rather than sliding in as a
          block. `data-reveal-group` is gone from the grid: it staggers its
          children on one shared direction, which is the effect being replaced. */}
      <div class="shell pair__grid">
        <figure class="pair__major" data-reveal data-reveal-shift="80">
          <Image
            src={livingRoom}
            alt={c.alt.livingRoom}
            widths={[640, 960, 1280, 1445]}
            sizes="(max-width: 900px) 100vw, 62vw"
          />
        </figure>
        <figure class="pair__minor" data-reveal="down" data-reveal-shift="80">
          <Image
            src={lobby}
            alt={c.alt.lobby}
            widths={[480, 720, 961]}
            sizes="(max-width: 900px) 100vw, 34vw"
          />
        </figure>
      </div>
    </div>

    <div class="section section--dark quoteband quoteband--flush-top">
      <div class="shell shell--narrow">
        <figure class="quote" data-reveal>
          <blockquote class="quote__text">
            <p>{c.bacchiQuote}</p>
          </blockquote>
          <figcaption class="quote__by">Paulo Bacchi</figcaption>
        </figure>
      </div>
    </div>

    {/* Carla Guilhem as a partner card, the shape the Team page gives her —
        edge to edge, photograph filling one half, copy on the olive ground she
        carries there. Out of the shell on purpose, exactly as that card is. */}
    <article class="firm" aria-labelledby="guilhem-heading">
      <figure class="firm__figure" data-reveal="fade">
        <Image
          src={bedroom}
          alt={c.alt.bedroom}
          widths={[640, 960, 1280]}
          sizes="(max-width: 900px) 100vw, 50vw"
        />
      </figure>

      {/* The card is two halves. The interior holds the left; this is the
          right, and it carries the copy and her portrait side by side so that
          she stays against the window's edge without taking a column of her
          own away from the text. */}
      <div class="firm__side">
        <div class="firm__copy" data-reveal>
          <div class="firm__inner">
            <p class="eyebrow firm__role">{c.guilhemRole}</p>
            <h2 class="heading firm__name" id="guilhem-heading">Carla Guilhem</h2>
            <hr class="firm__rule" />
            <p class="prose firm__body">{c.guilhemBody}</p>
          </div>
        </div>

        {/* The supplied file is mostly empty — she occupies x 412-861 of a
            1342-wide canvas — so dropped in as-is she would float well short
            of the edge. The frame in the stylesheet carries her proportions
            and the offset that brings her shoulder to the window. */}
        <figure class="firm__portrait" data-reveal="fade" data-reveal-delay="0.1">
          <Image
            src={guilhemPortrait}
            alt={c.guilhemPortraitAlt}
            widths={[160, 240, 320]}
            sizes="(max-width: 1080px) 26vw, 150px"
            loading="lazy"
          />
        </figure>
      </div>
    </article>

    {/* The second quote band is the first one again — same ground, same
        treatment — so the two claims read as a pair rather than as one dark
        moment and one light one. */}
    <div class="section section--dark quoteband quoteband--flush-bottom">
      <div class="shell shell--narrow">
        <figure class="quote" data-reveal>
          <blockquote class="quote__text">
            <p>{c.guilhemQuote}</p>
          </blockquote>
          <figcaption class="quote__by">Carla Guilhem</figcaption>
        </figure>
      </div>
    </div>

    {/* The closing pair mirrors the one above: there the minor image drops
        below its neighbour on the right, here it drops on the left, so the two
        asymmetries lean opposite ways instead of repeating. */}
    <div class="section section--alt pair pair--mirrored">
      {/* Directions swap with the layout: here the left frame drops in from
          above and the right rises from below. */}
      <div class="shell pair__grid">
        <figure class="pair__minor" data-reveal="down" data-reveal-shift="80">
          <Image
            src={kitchen}
            alt={c.alt.kitchen}
            widths={[480, 720, 1080]}
            sizes="(max-width: 900px) 100vw, 34vw"
          />
        </figure>
        <figure class="pair__major" data-reveal data-reveal-shift="80">
          <Image
            src={openPlan}
            alt={c.alt.openPlan}
            widths={[640, 960, 1280, 1445]}
            sizes="(max-width: 900px) 100vw, 62vw"
          />
        </figure>
      </div>
    </div>

  </div>

  {/* OUTSIDE the dark wrapper, deliberately.

      The lead-capture band is the same on every page of the site and has to
      stay that way — its veil is mixed from `--ground-alt`, so while it sat
      inside the wrapper it inherited this page's dark ground and the form came
      out a different colour here than anywhere else. The presentation call to
      action keeps its own navy for the same reason: both belong to the site's
      closing sequence rather than to this page's dark treatment. */}
  <PresentationCTA locale={locale} />

  <section class="section section--alt" id="inquire" aria-labelledby="inquire-heading">
    <div class="shell">
      <InquiryForm locale={locale} variant="full" headingId="inquire-heading" />
    </div>
  </section>
</Base>

<style>
  /* --- The dark ground -----------------------------------------------------
     Four token re-points turn every section on this page. `.page-head`,
     `.section--alt`, `.rule`, the prose — all of them read their colour from
     these, so nothing below needs restyling and no other page can be reached:
     the wrapper class exists only in this file, and custom properties inherit
     down, never across.

     `--accent` moves to --gold-light. Raw --gold measures 4.0:1 on charcoal,
     which fails AA for type this small; the Team page's Artefacto card made
     the same substitution for the same reason.

     `--ground-dark` is untouched, so the quote bands keep the navy the owner
     asked to leave alone. */
  .dark-page {
    /* ONE ground for the whole page. `--ground-alt` and `--ground-dark` are
       pointed at the same charcoal rather than at the sand-pale and navy they
       normally carry, so the page reads as a single dark surface instead of
       alternating bands — no blue anywhere between the head and the closing
       call to action, which keeps its own navy outside this wrapper. */
    --ground: var(--charcoal);
    --ground-alt: var(--charcoal);
    --ground-dark: var(--charcoal);
    --ink: var(--ink-on-dark);
    --ink-muted: var(--ink-on-dark-muted);
    --rule: var(--rule-on-dark);
    --accent: var(--gold-light);

    background: var(--ground);
    color: var(--ink);
  }

  /* With every section on the same ground the seams between them disappear,
     which is the point — but the quote bands then need their own breathing
     room rather than a colour change to set them apart. */
  .dark-page .quoteband { padding-block: var(--s-9); }

  /* The first quote follows the image pair and the second is followed by one,
     so each drops the padding on that side and sits against the photographs
     rather than floating in a gap of its own ground. */
  /* Scoped through .dark-page like the rule above them. Written as bare
     `.quoteband--flush-*` they lost to `.dark-page .quoteband` on specificity
     and did nothing at all — the padding stayed at 96px both ends. */
  .dark-page .quoteband--flush-top { padding-top: 0; }
  .dark-page .quoteband--flush-bottom { padding-bottom: 0; }

  /* --- The firm's portrait -------------------------------------------------
     Cut to the top 65% of the picture. The frame's ratio is the image's own
     width over 65% of its height (1342 x 816), and the picture inside sits at
     its natural proportions, so the frame clips the bottom third rather than
     the image being squashed into it. Change the file and this stays honest
     only if the numbers change with it. */
  /* No lower padding at all: the portrait is the last thing in the head and
     is clipped flat across its bottom, so the section ends where the picture
     does and the band below begins against it. */
  .dark-page .page-head { padding-bottom: 0; }

  /* 922px is the file's own width. It runs at exactly that on any window wide
     enough to hold it and shrinks only when the window is narrower, which is
     what `min()` says: never larger than natural size, never wider than the
     space available. */
  .portrait {
    /* Six tenths of the picture, measured off its own 922x627. The frame is
       cut to that height and clips the rest; the picture inside keeps its
       natural proportions, so the bottom is CUT rather than the whole image
       squashed into a shorter box. Replacing the file means changing both
       numbers — they are its real dimensions, not a guess. */
    --portrait-visible: 0.6;

    width: min(922px, 100%);
    margin: var(--s-6) 0 0;
    overflow: hidden;
    aspect-ratio: 922 / calc(627 * var(--portrait-visible));
  }

  .portrait :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* tokens.css sets this eyebrow to --gold-ink, a dark gold chosen for the
     sand ground. On charcoal it is 1.9:1 and effectively invisible. */
  .dark-page .page-head .eyebrow { color: var(--gold-light); }

  /* --- Full-bleed bands ---------------------------------------------------
     The wrapper owns the crop; the image overfills it and drifts inside the
     clip. Specificity here deliberately beats Astro's responsive styles. */
  .band {
    position: relative;
    display: grid;
    place-items: center;
    overflow: clip;
    background: var(--navy-deep);
    isolation: isolate;
  }

  /* Tall enough to seat the editorial copy it now carries — the old 16/7 crop
     was sized for a photograph with nothing on it. It is a MINIMUM, so a long
     translation lengthens the band rather than being clipped by it. */
  .band--hero {
    min-height: min(84svh, 860px);
    padding-block: var(--s-8);
  }

  .band :global(img) {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    object-fit: cover;
  }

  /* The homepage stack bands' gradient, and for the same reason: it radiates
     from the centre where the type sits and thins towards the edges, so the
     photograph is muted only where it has to be. This band does not stick or
     stack — it is the treatment that is shared, not the mechanic.

     MEASURED across three languages and ten viewport sizes, sampling the
     lightest pixel behind every line: worst case 5.52:1, against AA's 4.5.

     THREE corrections carry that, because three different things push the copy
     out of the core, and no one media query catches another's case:

       narrow window   the ends of the lines reach the fade
       short window    the top and bottom of the block reach it instead
       small phone     both at once, with nothing left to widen towards

     A 1024x768 tablet sat in the gap between the first two — too wide for one,
     too tall for the other — and measured 4.40:1 on desktop radii it had no
     business using, which is why the first now starts at 1080px rather than
     900. Re-measure across the RANGE after changing the copy, the radii or the
     band's min-height; one viewport is not evidence about the others. */
  .band__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    --scrim-rx: 82%;
    --scrim-ry: 66%;

    background: radial-gradient(
      ellipse var(--scrim-rx) var(--scrim-ry) at 50% 50%,
      var(--scrim-band) 0%,
      var(--scrim-band) 42%,
      color-mix(in srgb, var(--navy) 42%, transparent) 68%,
      color-mix(in srgb, var(--navy) 16%, transparent) 88%,
      transparent 100%
    );
  }

  .band__body {
    position: relative;
    z-index: 2;
    display: grid;
    justify-items: center;
    gap: var(--s-5);
    width: min(var(--max-w-narrow), 100% - var(--gutter) * 2);
    text-align: center;
  }

  .band__title {
    margin: 0;
    max-width: 18ch;
    color: var(--ink-on-dark);
    font-size: clamp(1.75rem, 1.1rem + 2.6vw, 3.4rem);
    font-weight: var(--w-thin);
    letter-spacing: var(--track-heading);
    line-height: 1.22;
    text-transform: uppercase;
  }

  .band__lede {
    margin: 0;
    max-width: 56ch;
    color: var(--ink-on-dark);
    font-size: var(--t-h4);
    font-weight: var(--w-xlight);
  }

  .band__rule {
    width: clamp(48px, 6vw, 90px);
    height: 1px;
    margin: 0;
    border: 0;
    background: var(--gold-light);
  }

  .band__text {
    margin: 0;
    max-width: 62ch;
    color: var(--ink-on-dark);
    line-height: var(--leading-body);
  }

  /* --- Asymmetric image pairs ---------------------------------------------- */
  .pair__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
    gap: clamp(var(--s-5), 4vw, var(--s-7));
    align-items: start;
  }

  .pair__major,
  .pair__minor { margin: 0; }

  /* The minor frame drops below its neighbour. In the first pair it is the
     right-hand column; the mirrored pair swaps the track widths so the minor
     leads on the left and the wide frame rides high on the right. */
  .pair__minor { margin-top: clamp(var(--s-6), 8vw, var(--s-10)); }

  .pair--mirrored .pair__grid {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.7fr);
  }

  /* --- Quote bands ---------------------------------------------------------
     The claim itself, set at heading scale. A gold hairline stands in for the
     opening mark so the type is never decorated. Both bands are identical now
     — same ground, same treatment — so the two claims read as a pair. */
  .quote {
    display: grid;
    gap: var(--s-5);
    justify-items: center;
    margin: 0;
    text-align: center;
  }

  .quote::before {
    content: '';
    width: clamp(48px, 6vw, 90px);
    height: 1px;
    background: var(--gold);
  }

  .quote__text {
    margin: 0;
    max-width: 26ch;
    color: var(--off-white);
    font-size: var(--t-h3);
    font-weight: var(--w-xlight);
    letter-spacing: var(--track-body);
    line-height: 1.55;
    text-wrap: balance;
  }

  /* --gold-ink is a dark gold chosen for light grounds; on this navy it
     measures 2.45:1, well under AA, and the attribution was effectively
     unreadable. It was already like that on the Bacchi band before this page
     was reworked — duplicating the band for Carla Guilhem would have shipped
     the fault twice, so it is corrected here rather than carried over.
     --gold-light is 7.5:1 on the same ground and still reads as gold. */
  .quote__by {
    color: var(--gold-light);
    font-size: var(--t-micro);
    font-style: normal;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
  }

  /* --- Carla Guilhem, as a partner card -------------------------------------
     The shape the Team page gives her: edge to edge, photograph filling one
     half, copy on the olive ground she carries there. Deliberately a scoped
     copy rather than a shared component — this is the SECOND of these, and
     this repo's rule is to extract at the third. If a third appears, lift the
     card geometry out of the-team.astro and put all three on it. */
  .firm {
    display: grid;
    /* Two equal halves: the interior, and everything about her. */
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: stretch;
    background: var(--olive-tan);
    color: var(--ink-on-dark);
    /* Contains the portrait, which is deliberately wider than its column. */
    overflow: clip;
  }

  .firm__figure {
    margin: 0;
    min-height: 100%;
  }

  .firm__figure :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Copy and portrait share the right half. The portrait column is `auto`, so
     it takes only the width the picture asks for and the copy keeps the rest —
     she is an accent at the edge, not a second column competing with the text. */
  .firm__side {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
  }

  .firm__copy {
    display: grid;
    align-items: center;
    padding: clamp(var(--s-6), 5vw, var(--s-9)) clamp(var(--s-5), 4vw, var(--s-8));
  }

  .firm__inner {
    display: grid;
    gap: var(--s-4);
    max-width: 46ch;
  }

  /* --gold-ink drops to 2.41:1 on the olive, which is why the Team page gives
     this one card ink rather than gold for its eyebrow. Same choice here. */
  .firm__role { color: var(--ink-on-dark); }

  .firm__name { color: var(--ink-on-dark); }

  .firm__rule {
    width: clamp(48px, 6vw, 90px);
    height: 1px;
    margin-block: var(--s-1);
    border: 0;
    background: var(--gold-light);
  }

  .firm__body { color: var(--ink-on-dark); }

  /* --- Her portrait, against the window's right edge ------------------------
     The supplied PNG is a cut-out on a 1342x816 canvas, and the subject sits
     in the middle of it: x 412-861, y 43-815. Two thirds of the file is empty.
     Dropped in whole she would stand a third of the way in from the edge with
     a wide transparent gap beside her, which is the opposite of butted up
     against it.

     So the frame takes HER proportions rather than the file's, and
     object-position slides the canvas until her right shoulder meets the
     frame's right edge. `100%` on the vertical pins her to the bottom, which
     the file already sits flush against. The single number is measured, not
     guessed — verified in the browser against the subject's own bounding box. */
  /* --- Her portrait, against the window's right edge ------------------------
     The supplied PNG is a cut-out on a 1342x816 canvas and two thirds of it is
     empty: she occupies x 412-861, y 43-815. Dropped in whole she stands a
     third of the way in from the edge with a wide transparent gap beside her.

     So the frame takes HER proportions — a little wider, so she has air on one
     side rather than filling it corner to corner — and object-position slides
     the canvas until her right shoulder meets the frame's right edge, which is
     the window's. `100%` on the vertical pins her to the bottom, which the file
     already sits flush against.

     39.3% is arithmetic, not taste: the frame crops 0.972 of its own height
     from the canvas width, and her right edge sits 0.382 of that in. Both
     numbers move if the file is replaced — measure the new one's subject box
     before changing it. */
  /* She held a 360px column before this; 110px is the seventy per cent
     reduction asked for. It is deliberately ONE number — change
     `--portrait-w` and nothing else moves, because the proportions and the
     offset that keeps her against the window are both expressed relative to
     the frame rather than in pixels of their own. */
  .firm__portrait {
    --portrait-w: 110px;

    align-self: end;
    width: var(--portrait-w);
    margin: 0;
    aspect-ratio: 520 / 773;
  }

  .firm__portrait :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 39.3% 100%;
  }

  @media (max-width: 900px) {
    .pair__grid,
    .pair--mirrored .pair__grid { grid-template-columns: 1fr; }
    .pair__minor { margin-top: 0; }
  }

  /* Tablets stack the card the way phones do — the interior above, the copy
     below — but the portrait keeps the place it holds on a desktop, beside the
     copy and against the right edge, rather than dropping into the stack and
     becoming a third full-width band. 1080px, not 900, so a portrait-held
     tablet is on this side of the line rather than squeezing three columns
     into 1024px. */
  @media (max-width: 1080px) {
    .firm { grid-template-columns: minmax(0, 1fr); }
    .firm__figure { aspect-ratio: 16 / 9; }
    /* She grows a little as the half she sits in narrows, so she does not
       shrink to a detail on the devices where the card is tallest. */
    .firm__portrait { --portrait-w: clamp(120px, 22vw, 200px); }
  }

  /* The copy runs nearly edge to edge below this width, so the core has to
     reach past the band's own width to keep the ends of the lines out of the
     fade — the same correction HomeStack makes, for the same reason. Measured:
     at the desktop radii the body text fell to 2.94:1 on a Portuguese phone,
     where the paragraph wraps widest. */
  /* 1080, not 900. A 1024x768 tablet fell into the gap between this rule and
     the short-window one below — too wide for one, too tall for the other —
     and measured 4.40:1 there, just under AA, on desktop radii it had no
     business using. The band's copy is already running close to the window's
     width well before 900px. */
  @media (max-width: 1080px) {
    .band__scrim {
      --scrim-rx: 130%;
      --scrim-ry: 74%;
    }
  }

  /* A SHORT window is a separate failure from a narrow one, and needs a
     separate correction. The band is `min(84svh, …)`, so in a 620px-tall
     window it is barely taller than the copy inside it — the paragraph then
     reaches the top and bottom of the ellipse rather than sitting in its
     middle, and the vertical radius is what has to give. Measured: Portuguese
     at 1280x620 fell to 3.68:1 with the width rule alone, which never fires at
     that width. */
  @media (max-height: 760px) {
    .band__scrim {
      --scrim-ry: 96%;
