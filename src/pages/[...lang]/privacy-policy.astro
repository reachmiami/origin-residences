---
import Base from '../../layouts/Base.astro';
import InquiryForm from '../../components/InquiryForm.astro';
import { useTranslations, localizePath, localeStaticPaths, localeFromParam } from '../../i18n/ui';
import { getCopy } from '../../content/copy';
import { legalCopy, legalBody } from '../../content/pages/legal';
import { ADDRESS, PHONE, PHONE_HREF } from '../../data/contact';

/* Sourced from what the Site actually does and from the incumbent's own
   published notices — the form consent language and the marketing-email
   notice. No claim appears here that the build cannot support: the
   incumbent's cookie and Google Analytics notice is deliberately absent,
   because this build sets no cookies and loads no analytics. It goes back
   in the day something is actually installed.

   The policy text itself stays in ENGLISH on every locale — see the note at
   the head of src/content/pages/legal.ts. Only the title, meta, the
   English-text notice and the cross-references are translated. */

export function getStaticPaths() {
  return localeStaticPaths();
}

const locale = localeFromParam(Astro.params?.lang);
const t = useTranslations(locale);
const L = (p: string) => localizePath(p, locale);

/* BCP47 casing for the lang attribute on the translated cross-references. */
const htmlLang = locale === 'pt-br' ? 'pt-BR' : locale;

const chrome = legalCopy[locale];
const c = chrome.privacy;
const body = legalBody.privacy;

/* The consent paragraph is quoted as it appears on the forms. English, on
   every locale, for the same reason the rest of the policy is. */
const consent = getCopy('en').forms.consent;

const EMAIL = 'germanr.realty@gmail.com';
---

<Base
  title={c.metaTitle}
  description={c.metaDescription}
  locale={locale}
  path="privacy-policy"
>
  <header class="page-head">
    <div class="shell shell--narrow">
      <p class="eyebrow">{c.eyebrow}</p>
      <h1 class="page-head__title">{c.title}</h1>
      <hr class="page-head__rule" />
      {chrome.englishNote && <p class="page-head__note">{chrome.englishNote}</p>}
    </div>
  </header>

  <div class="section legal">
    <div class="shell shell--narrow legal__inner" lang="en">
      <p class="legal__lede" data-reveal>{body.lede}</p>

      <section class="legal__section" aria-labelledby="privacy-collect" data-reveal>
        <h2 class="subheading" id="privacy-collect">{body.collectTitle}</h2>
        <p class="prose">{body.collectIntro}</p>
        <ul class="legal__list">
          {body.collected.map((line) => <li>{line}</li>)}
        </ul>
        <p class="prose">{body.collectNote}</p>
      </section>

      <section class="legal__section" aria-labelledby="privacy-use" data-reveal>
        <h2 class="subheading" id="privacy-use">{body.useTitle}</h2>
        <p class="prose">{body.useBody}</p>
      </section>

      <section class="legal__section" aria-labelledby="privacy-consent" data-reveal>
        <h2 class="subheading" id="privacy-consent">{body.consentTitle}</h2>
        <p class="prose">{consent}</p>
      </section>

      <section class="legal__section" aria-labelledby="privacy-marketing" data-reveal>
        <h2 class="subheading" id="privacy-marketing">{body.marketingTitle}</h2>
        <p class="prose">{body.marketingBody}</p>
      </section>

      <section class="legal__section" aria-labelledby="privacy-cookies" data-reveal>
        <h2 class="subheading" id="privacy-cookies">{body.cookiesTitle}</h2>
        <p class="prose">{body.cookiesBody}</p>
      </section>

      <section class="legal__section" aria-labelledby="privacy-contact" data-reveal>
        <h2 class="subheading" id="privacy-contact">{body.contactTitle}</h2>
        <p class="prose">
          {body.contactBeforeEmail}<a href={`mailto:${EMAIL}`}>{EMAIL}</a>{
            body.contactBetweenEmailPhone
          }<a href={PHONE_HREF}>{PHONE}</a>{body.contactBetweenPhoneAddress}{ADDRESS}{
            body.contactAfterAddress
          }
        </p>
        {/* Cross-references are navigation, so they follow the reader's
            language even though the policies themselves do not. */}
        <p class="prose" lang={htmlLang}>
          {c.seeAlso.lead}<a href={L('terms-of-use')}>{t('terms')}</a>{c.seeAlso.join}<a
            href={L('accessibility')}>{t('accessibility')}</a>{c.seeAlso.tail}
        </p>
      </section>
    </div>
  </div>

  {/* Every page carries the form at its foot so the Inquire and Schedule
      Private Presentation controls always have somewhere on-page to land. */}
  <section class="section section--alt" id="inquire" aria-labelledby="inquire-heading">
    <div class="shell">
      <InquiryForm locale={locale} variant="compact" headingId="inquire-heading" />
    </div>
  </section>
</Base>

<style>
  .page-head {
    padding-block: calc(var(--header-h) + clamp(var(--s-6), 6vw, var(--s-9)))
      clamp(var(--s-6), 4vw, var(--s-8));
    background: var(--ground);
  }

  /* The shared eyebrow is gold, which is 2.1:1 on this sand ground. Darkened
     against --navy-deep it holds the accent and clears AA. */
  .eyebrow {
    color: var(--gold-ink, color-mix(in srgb, var(--gold) 52%, var(--navy-deep)));
  }

  .page-head__title {
    margin-top: var(--s-4);
    font-size: var(--t-h1);
    font-weight: var(--w-thin);
    letter-spacing: var(--track-display);
    text-transform: uppercase;
  }

  .page-head__rule {
    width: clamp(64px, 8vw, 120px);
    height: 1px;
    margin-top: clamp(var(--s-5), 3vw, var(--s-6));
    border: 0;
    background: var(--gold);
  }

  /* Only rendered on es and pt-br: the policy below is published in English. */
  .page-head__note {
    max-width: var(--measure);
    margin-top: var(--s-5);
    font-size: var(--t-small);
    font-weight: var(--w-light);
    line-height: 1.8;
    color: var(--ink-muted);
  }

  .legal { background: var(--ground-alt); }

  .legal__inner { display: grid; gap: clamp(var(--s-6), 4vw, var(--s-8)); }

  .legal__lede {
    max-width: var(--measure);
    font-size: var(--t-h4);
    font-weight: var(--w-light);
    line-height: 1.85;
  }

  .legal__section { display: grid; gap: var(--s-4); }

  .legal__list {
    display: grid;
    gap: var(--s-3);
    max-width: var(--measure);
  }

  .legal__list li {
    padding-left: var(--s-5);
    font-size: var(--t-small);
    line-height: 1.8;
    border-left: 1px solid var(--rule);
  }

  .legal a {
    color: var(--ink);
    border-bottom: 1px solid var(--rule);
    overflow-wrap: anywhere;
    transition: color var(--dur-fast) var(--ease-out),
                border-color var(--dur-fast) var(--ease-out);
  }
  .legal a:hover { color: var(--gold-ink); border-bottom-color: var(--gold); }
</style>
