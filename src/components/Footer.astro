---
import { useTranslations, localizePath, HOME_PATH, type Locale } from '../i18n/ui';
import { exploreLinks, homeLabel } from '../data/nav';
import { unitsByLevel, unitCount } from '../data/units';
import SalesContact from './SalesContact.astro';

import developer from '../assets/brand/partner-Grupo-914.svg?raw';
import interiors from '../assets/brand/partner-Grupo-915.svg?raw';
import design from '../assets/brand/partner-Logo_Carla.svg?raw';
import architecture from '../assets/brand/partner-Grupo-916.svg?raw';
import construction from '../assets/brand/partner-thornton.svg?raw';
import sales from '../assets/brand/partner-Grupo-917.svg?raw';
import { ADDRESS_LINES, MAP_HREF, PHONE, PHONE_HREF } from '../data/contact';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const L = (p: string) => localizePath(p, locale);

const current = Astro.url.pathname;
const isCurrent = (p: string) => current === L(p);

/* Credit order is the incumbent site's own. Marks are supplied as artwork
   without embedded names, so the heading carries the meaning. */
const credits = [
  { key: 'developed', svg: developer, label: { en: 'Developed by', es: 'Desarrollado por', 'pt-br': 'Desenvolvido por' } },
  { key: 'interiors', svg: interiors, label: { en: 'Interiors by', es: 'Interiores por', 'pt-br': 'Interiores por' } },
  { key: 'design', svg: design, label: { en: 'Design by', es: 'Diseño por', 'pt-br': 'Design por' } },
  { key: 'architecture', svg: architecture, label: { en: 'Architecture by', es: 'Arquitectura por', 'pt-br': 'Arquitetura por' } },
  { key: 'construction', svg: construction, label: { en: 'Construction by', es: 'Construcción por', 'pt-br': 'Construção por' } },
  { key: 'sales', svg: sales, label: { en: 'Sales by', es: 'Ventas por', 'pt-br': 'Vendas por' } },
];

const year = new Date().getFullYear();

/* The site's own Terms of Use notice, as supplied by the owner. Legal wording
   is served in English in every locale — see TRANSLATION-REVIEW.md for why
   that is deliberate. */
const DISCLAIMER =
  'YOUR USE OF THIS WEBSITE (the “Site”) CONSTITUTES ACCEPTANCE OF THE TERMS AND CONDITIONS PROVIDED BELOW (the “Terms”). These Website Terms of Use (“Terms of Use”) describe the terms pursuant to which Bay Harbour Investment, Inc and/or an affiliated entity (referred to in these Terms of Use as the “Company,” “we,” “us” and “our”) provides the website located at www.originresidences.com (the “Site”). We prepared these Terms of Use to help explain the terms that apply to your use of the Site. We may modify the Terms of Use as well as discontinue, withdraw, replace or change any content or services offered via the Site at any time and your continued access and use of the Site thereafter constitutes your acceptance of such changes. You may view the most up-to-date version of the Terms at any time at https://www.originresidences.com. By using this Site, you agree to these Terms of Use. If you do not agree to these Terms of Use, please do not use this Site.';

const disclaimerHeading: Record<Locale, string> = {
  en: 'Disclaimer',
  es: 'Aviso legal',
  'pt-br': 'Aviso legal',
};
---

<footer class="footer">
  <div class="shell">
    <section class="credits" aria-label="Project partners">
      <ul class="credits__grid" data-reveal-group>
        {credits.map((c) => (
          <li class="credit">
            <h2 class="credit__label">{c.label[locale]}</h2>
            <div class="credit__mark" role="img" aria-label={c.label[locale]}>
              <Fragment set:html={c.svg} />
            </div>
          </li>
        ))}
      </ul>
    </section>

    <div class="footer__meta">
      <div class="footer__block">
        <h2 class="footer__heading">{t('call')}</h2>

        {/* The sales gallery address, on its own two lines as published. */}
        <address class="footer__address">
          <a class="footer__value" href={MAP_HREF} target="_blank" rel="noopener noreferrer">
            {ADDRESS_LINES.map((line) => <span class="footer__address-line">{line}</span>)}
          </a>
        </address>

        <a class="footer__value" href={PHONE_HREF}>{PHONE}</a>
        <SalesContact locale={locale} tone="dark" class="footer__sales" />

        {/* The icons sit under the named contact rather than under a label of
            their own — the aria-labels already say where each one goes. */}
        <ul class="footer__social">
          <li>
            <a href="https://www.facebook.com/originresidences" target="_blank" rel="noopener noreferrer" aria-label="Origin Residences on Facebook">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                <path d="M14 8.5V6.9c0-.7.2-1.1 1.2-1.1H16V3.1A17 17 0 0 0 14.2 3C12 3 10.6 4.3 10.6 6.6v1.9H8.5V11h2.1v8h3v-8h2.2l.3-2.5H14Z" />
              </svg>
            </a>
          </li>
          <li>
            <a href="https://www.instagram.com/originresidences" target="_blank" rel="noopener noreferrer" aria-label="Origin Residences on Instagram">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <rect x="3.5" y="3.5" width="17" height="17" rx="4.6" />
                <circle cx="12" cy="12" r="3.6" />
                <circle cx="16.9" cy="7.1" r="1" fill="currentColor" stroke="none" />
              </svg>
            </a>
          </li>
        </ul>
      </div>

      {/* Column two: the same list the header's mega panel carries, plus Home,
          which the header expresses as the logo instead. */}
      <nav class="footer__block" aria-labelledby="footer-menu">
        <h2 class="footer__heading" id="footer-menu">{t('explore')}</h2>
        <ul class="footer__links">
          <li>
            <a
              class="footer__link"
              href={L(HOME_PATH)}
              aria-current={isCurrent(HOME_PATH) ? 'page' : undefined}
            >{homeLabel[locale]}</a>
          </li>
          {exploreLinks.map((link) => (
            <li>
              <a
                class="footer__link"
                href={L(link.path)}
                aria-current={isCurrent(link.path) ? 'page' : undefined}
              >{link.label[locale]}</a>
            </li>
          ))}
        </ul>
      </nav>

      {/* Column three: the released residences, grouped by level exactly as the
          mega panel groups them. `unitsByLevel` is built from the released-only
          set, so an unreleased unit cannot appear here. */}
      <nav class="footer__block footer__block--residences" aria-labelledby="footer-residences">
        <h2 class="footer__heading" id="footer-residences">
          {t('residences')} <span class="footer__count">{unitCount}</span>
        </h2>
        <ul class="footer__levels">
          {unitsByLevel.map((group) => (
            <li class="footer__level">
              <span class="footer__level-label">{group.label}</span>
              <ul class="footer__units">
                {group.units.map((u) => (
                  <li>
                    <a
                      class="footer__unit"
                      href={L(u.slug)}
                      aria-current={isCurrent(u.slug) ? 'page' : undefined}
                    >
                      <span class="footer__unit-no">{u.number}</span>
                      <span class="footer__unit-spec">{u.beds}{u.hasDen ? '+D' : ''} / {u.baths}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="footer__disclaimer">
      <p class="footer__disclaimer-body">{DISCLAIMER}</p>
    </div>

    <div class="footer__legal">
      <nav class="footer__legal-links" aria-label="Legal">
        <a href={L('terms-of-use')}>{t('terms')}</a>
        <a href={L('privacy-policy')}>{t('privacy')}</a>
        <a href={L('accessibility')}>{t('accessibility')}</a>
      </nav>
      <p class="footer__copy">&copy; {year} Origin Residences. {t('rights')}</p>
    </div>

    {/* Maker's credit. The heart replaces the word, so the word itself stays in
        the accessible name — a screen reader still reads "Made with heart in
        Miami" and the icon is hidden from it. */}
    <div class="footer__legal footer__made">
      <a
        class="footer__made-link"
        href="https://reach.miami"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span>Made with</span>
        <svg class="footer__heart" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
        </svg>
        <span class="visually-hidden">heart</span>
        <span>in Miami.</span>
      </a>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--navy);
    color: var(--ink-on-dark);
    padding-block: var(--s-7);
  }

  .credits__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: clamp(var(--s-5), 3vw, var(--s-8));
    align-items: start;
  }

  .credit {
    display: grid;
    gap: var(--s-4);
    justify-items: center;
    text-align: center;
  }

  .credit__label {
    font-size: var(--t-micro);
    font-weight: var(--w-light);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--gold);
  }

  /* Partner marks arrive in mixed fills; normalise them to the footer's
     warm white so the row reads as one system. */
  .credit__mark :global(svg) {
    /* Block + auto margins so the mark is centred on the label by its own box
       rather than by inherited text-align, which an inline SVG resolves against
       its baseline and which the sizing change below could otherwise upset. */
    display: block;
    width: auto;
    max-width: 100%;
    /* 80% of the size these were. Written as the original clamp times 0.8 so
       the fluid range stays intact and the reduction is legible. */
    height: calc(clamp(30px, 3.4vw, 42px) * 0.8);
    margin-inline: auto;
    opacity: 0.8;
  }
  .credit__mark :global(svg *) {
    fill: var(--off-white);
    stroke: none;
  }

  /* The three bands below the credits share one rhythm: equal margin and
     padding above, separated by the same hairline. */
  .footer__meta {
    display: grid;
    /* Contact · menu · residences. The first column carries the most content,
       so it takes the widest share rather than three equal thirds. */
    grid-template-columns: 1.3fr 1fr 1fr;
    gap: clamp(var(--s-5), 4vw, var(--s-8));
    margin-top: var(--s-5);
    padding-top: var(--s-5);
    border-top: 1px solid var(--rule-on-dark);
  }

  /* --- Column one: contact ------------------------------------------------- */

  .footer__address { font-style: normal; }

  /* Two lines as published, rather than one line folded by the column width. */
  .footer__address-line { display: block; }

  /* --- Column two: menu ---------------------------------------------------- */

  .footer__links { display: grid; gap: var(--s-1); }

  .footer__link {
    display: inline-block;
    font-size: var(--t-small);
    font-weight: var(--w-light);
    line-height: 1.8;
    letter-spacing: var(--track-body);
    color: var(--ink-on-dark-muted);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .footer__link:hover,
  .footer__link[aria-current='page'] { color: var(--gold); }

  /* --- Column three: released residences ----------------------------------- */

  .footer__count { color: var(--ink-on-dark-muted); }

  .footer__levels { display: grid; gap: var(--s-3); }

  /* Level label beside its units rather than above them, at every width. */
  .footer__level {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
  }

  .footer__level-label {
    /* Fixed basis so the unit lists line up with each other down the column —
       "PH Level 7" is wider than "Level 3", and left to size themselves the
       rows would each start at a different x. */
    flex: 0 0 auto;
    /* 6.2em, not 5.5: the longest label today ("PH Level 7") measures 62px
       against a 63px column, so 5.5em left a single pixel of margin and any
       longer level name would have wrapped. */
    min-width: 6.2em;
    font-size: var(--t-micro);
    letter-spacing: var(--track-body);
    color: var(--ink-on-dark-muted);
    opacity: 0.7;
  }

  .footer__units { display: grid; gap: 2px; min-width: 0; }

  /* Number and spec on one row, as the mega panel sets them. */
  .footer__unit {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    font-size: var(--t-small);
    font-weight: var(--w-light);
    letter-spacing: var(--track-body);
    color: var(--ink-on-dark-muted);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .footer__unit:hover,
  .footer__unit[aria-current='page'] { color: var(--gold); }

  .footer__unit-spec { font-size: var(--t-micro); opacity: 0.72; }

  /* min-width: 0 because grid items default to min-width: auto and will not
     shrink below their min-content width. The sales email is a single unbroken
     token, so without this it sets the whole column's floor and shoves the next
     column off the screen — measured 8px of document overflow at 320px. */
  .footer__block {
    display: grid;
    gap: var(--s-2);
    align-content: start;
    min-width: 0;
  }

  /* Same reason, at the token level: let that one long address wrap. */
  .footer__block :global(.sales-contact) { overflow-wrap: anywhere; }

  .footer__heading {
    font-size: var(--t-micro);
    font-weight: var(--w-light);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: var(--s-1);
  }

  .footer__value {
    font-size: var(--t-small);
    font-weight: var(--w-light);
    line-height: 1.8;
    color: var(--ink-on-dark-muted);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .footer__value:hover { color: var(--off-white); }

  .footer__social { display: flex; gap: var(--s-4); margin-top: var(--s-4); }
  .footer__social a {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 1px solid var(--rule-on-dark);
    border-radius: 50%;
    color: var(--ink-on-dark-muted);
    transition: color var(--dur-fast) var(--ease-out),
                border-color var(--dur-fast) var(--ease-out);
  }
  .footer__social a:hover { color: var(--gold); border-color: var(--gold); }

  /* Separated from the meta row by the same hairline the legal row uses, so
     the three bands read as one system. */
  .footer__disclaimer {
    margin-top: var(--s-5);
    padding-top: var(--s-5);
    border-top: 1px solid var(--rule-on-dark);
  }

  .footer__disclaimer-body {
    font-size: var(--t-micro);
    font-weight: var(--w-light);
    line-height: 1.85;
    letter-spacing: var(--track-body);
    color: var(--ink-on-dark-muted);
  }

  .footer__sales { margin-top: var(--s-1); }

  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    margin-top: var(--s-5);
    padding-top: var(--s-5);
    border-top: 1px solid var(--rule-on-dark);
  }

  .footer__legal-links { display: flex; flex-wrap: wrap; gap: var(--s-5); }

  .footer__legal-links a,
  .footer__copy {
    font-size: var(--t-micro);
    letter-spacing: var(--track-body);
    color: var(--ink-on-dark-muted);
  }
  .footer__legal-links a:hover { color: var(--gold); }

  /* --- Maker's credit ------------------------------------------------------ */

  /* Two class names, not one, on purpose: the narrow-screen block below resets
     `.footer__legal` to flex-start, and a single-class rule here would lose to
     it at 640px and under. This outranks it at every width. */
  .footer__legal.footer__made { justify-content: center; }

  .footer__made-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-size: var(--t-micro);
    letter-spacing: var(--track-body);
    color: var(--ink-on-dark-muted);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .footer__made-link:hover { color: var(--gold); }

  /* The heart carries its OWN colour rather than inheriting the link's, which
     is what keeps it red while the words around it go gold on hover. */
  .footer__heart {
    width: 1em;
    height: 1em;
    flex: none;
    color: var(--heart-red);
  }

  /* --- Tablet and below: smaller labels and marks --------------------------- */
  @media (max-width: 860px) {
    /* --t-micro is already the smallest token, so this is an explicit value. */
    .credit__label { font-size: 0.64rem; letter-spacing: 0.2em; }

    /* A further 20% off the 80% already applied — 0.8 × 0.8. Kept as the
       original clamp times a factor so the fluid range survives. */
    .credit__mark :global(svg) {
      height: calc(clamp(30px, 3.4vw, 42px) * 0.64);
    }
  }

  /* --- Tablet: all six visible, three across, nothing to scroll -------------
     A single row cannot hold them here. The six items measure 723px of content
     — three of them fixed by their LABEL rather than their mark ("Architecture
     by" is 128px on its own) — against roughly 585px of content width at 641px.
     Fitting one row would mean scaling everything to about 73%, which puts the
     labels near 7px. Two rows of three keeps them at a readable size. */
  @media (min-width: 641px) and (max-width: 860px) {
    .credits__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--s-6) var(--s-5);
    }
  }

  /* --- Mobile: one swipeable row --------------------------------------------
     The row bleeds to the viewport edges by cancelling the shell's gutter, then
     pads it back inside so the first and last marks are not flush to the screen.
     The scrollbar is left visible on purpose: nothing inside this row is
     focusable, so hiding it would leave the overflow with no affordance and no
     way to reach it without a touchscreen. */
  @media (max-width: 640px) {
    .credits__grid {
      display: flex;
      grid-template-columns: none;
      /* Tighter than the desktop rhythm so the marks read as one strip rather
         than as separate tiles — but still clear of each other. */
      gap: var(--s-5);
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x proximity;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      padding-bottom: var(--s-3);
    }

    /* Width from content, not a fixed share of the viewport: the marks differ
       enormously in proportion (Artefacto is 7.5:1, VDA 3.6:1) and a fixed
       share leaves the narrow ones stranded in whitespace. */
    .credit {
      flex: 0 0 auto;
      width: auto;
      scroll-snap-align: start;
    }

    /* --- Meta: two columns, residences dropped ---------------------------- */
    .footer__meta { grid-template-columns: 1fr 1fr; }

    /* The residences list is the one column that can go: every unit in it is
       also in the header's mega panel, so nothing becomes unreachable. */
    .footer__block--residences { display: none; }

    /* --- Legal row centred ------------------------------------------------ */
    .footer__legal { justify-content: center; text-align: center; }
    .footer__legal-links { justify-content: center; }
  }
</style>
