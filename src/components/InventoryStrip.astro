---
import { useTranslations, localizePath, type Locale } from '../i18n/ui';
import { getCopy } from '../content/copy';
import { unitsByLevel, unitCount, formatSqft } from '../data/units';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const c = getCopy(locale);
const L = (p: string) => localizePath(p, locale);
---

<section class="inventory section" aria-labelledby="inventory-heading">
  <div class="shell">
    <header class="inventory__head">
      <div>
        <h2 class="heading" id="inventory-heading" data-reveal>{c.home.inventoryTitle}</h2>
        <p class="inventory__count" data-reveal data-reveal-delay="0.08">
          <span class="inventory__number">{unitCount}</span>
          <span class="inventory__limited">{c.home.inventoryLimited}</span>
        </p>
      </div>
      <a class="inventory__all" href={L('residences')} data-reveal="fade">{t('viewAll')} &rarr;</a>
    </header>

    <p class="inventory__lede prose" data-reveal>{c.home.inventoryLede}</p>

    {/* Every residence, grouped by floor — the whole inventory legible at a
        glance rather than hidden behind a listing search. */}
    <ul class="levels" data-reveal-group>
      {unitsByLevel.map((group) => (
        <li class="level">
          <h3 class="level__label">{group.label}</h3>
          <ul class="level__units">
            {group.units.map((u) => (
              <li>
                <a class="ucard" href={L(u.slug)}>
                  <span class="ucard__no">{u.number}</span>
                  <span class="ucard__beds">
                    {u.beds}{u.hasDen ? ' + Den' : ''} / {u.baths}
                  </span>
                  <span class="ucard__area">{formatSqft(u.totalSqft)} sq. ft.</span>
                </a>
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ul>

    <div class="inventory__foot">
      <a class="btn btn--outline" href={L('residences')}>{c.home.inventoryCta}</a>
    </div>
  </div>
</section>

<style>
  .inventory { background: var(--ground-alt); }

  .inventory__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--s-4);
    padding-bottom: var(--s-5);
    border-bottom: 1px solid var(--rule);
  }

  .inventory__count { display: flex; align-items: baseline; gap: var(--s-3); margin-top: var(--s-3); }

  .inventory__number {
    font-size: var(--t-h2);
    font-weight: var(--w-thin);
    letter-spacing: var(--track-display);
    color: var(--gold-ink);
  }

  .inventory__limited {
    font-size: var(--t-micro);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .inventory__all {
    font-size: var(--t-micro);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--gold-ink);
    white-space: nowrap;
  }
  .inventory__all:hover { color: var(--ink); }

  .inventory__lede {
    margin-block: var(--s-6) var(--s-7);
    font-size: var(--t-h4);
    font-weight: var(--w-xlight);
    letter-spacing: var(--track-body);
    text-transform: uppercase;
    color: var(--ink);
  }

  .levels { display: grid; gap: var(--s-6); }

  .level {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: var(--s-5);
    align-items: start;
    padding-top: var(--s-5);
    border-top: 1px solid var(--rule);
  }

  .level__label {
    font-size: var(--t-micro);
    font-weight: var(--w-light);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--ink-muted);
    padding-top: var(--s-2);
  }

  .level__units {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(168px, 1fr));
    gap: var(--s-3);
  }

  .ucard {
    display: grid;
    gap: var(--s-1);
    padding: var(--s-4);
    background: var(--off-white);
    border: 1px solid transparent;
    transition: border-color var(--dur-fast) var(--ease-out),
                transform var(--dur-fast) var(--ease-out);
  }
  .ucard:hover { border-color: var(--gold); transform: translateY(-3px); }

  .ucard__no {
    font-size: var(--t-h3);
    font-weight: var(--w-thin);
    letter-spacing: var(--track-heading);
  }

  .ucard__beds {
    font-size: var(--t-micro);
    letter-spacing: var(--track-body);
    text-transform: uppercase;
    color: var(--ink);
  }

  .ucard__area {
    font-size: var(--t-micro);
    letter-spacing: var(--track-body);
    color: var(--ink-muted);
  }

  .inventory__foot { margin-top: var(--s-8); text-align: center; }

  .btn--outline {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-4) var(--s-7);
    border: 1px solid var(--navy);
    font-size: var(--t-micro);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    transition: background var(--dur-base) var(--ease-out),
                color var(--dur-base) var(--ease-out),
                border-color var(--dur-base) var(--ease-out);
  }
  .btn--outline:hover {
    background: var(--navy);
    color: var(--off-white);
  }

  @media (max-width: 720px) {
    .level { grid-template-columns: 1fr; gap: var(--s-3); }
    .level__units { grid-template-columns: repeat(auto-fill, minmax(136px, 1fr)); }
  }
</style>
