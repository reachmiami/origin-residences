---
import { Image } from 'astro:assets';
import { useTranslations, type Locale } from '../i18n/ui';

/**
 * An edge-to-edge band: half solid colour panel, half photograph.
 *
 * This is the shared implementation behind the homepage and Residences bands,
 * so the two pages cannot drift apart. Layout vocabulary follows the amenities
 * page: `flip` puts the image on the left, `tone` selects the panel colour.
 */
interface Props {
  id: string;
  /** Each entry is one deliberate line of the headline; they never wrap. */
  lines: string[];
  /** Small trailing line, e.g. a maker's name. */
  sub?: string;
  /** Single image. Ignored when `images` is given. */
  image?: ImageMetadata;
  alt?: string;
  /** Two or more slides turn the figure into a carousel. */
  images?: { src: ImageMetadata; alt: string }[];
  locale?: Locale;
  /** Image on the left instead of the right. */
  flip?: boolean;
  tone?: 'sand' | 'grey';
  /** Which line index onward carries the heavier weight. Default 1. */
  emphasisFrom?: number;
  /** Panel text alignment — the incumbent right-aligns some bands. */
  align?: 'start' | 'end';
}

const {
  id,
  lines,
  sub,
  image,
  alt,
  images,
  locale = 'en',
  flip = false,
  tone = 'sand',
  emphasisFrom = 1,
  align = 'start',
} = Astro.props;

const t = useTranslations(locale);

/* One code path for both cases: a lone image is just a one-slide set. */
const slides = images?.length ? images : image ? [{ src: image, alt: alt ?? '' }] : [];
const isCarousel = slides.length > 1;
---

<section
  class:list={[
    'feature',
    tone === 'sand' ? 'feature--alt' : 'feature--grey',
    { 'feature--flip': flip, 'feature--end': align === 'end' },
  ]}
  id={id}
  aria-labelledby={`${id}-heading`}
>
  <div class="feature__inner">
    <figure
      class:list={['feature__figure', { 'feature__figure--carousel': isCarousel }]}
      data-reveal="fade"
      data-carousel={isCarousel ? '' : undefined}
      role={isCarousel ? 'group' : undefined}
      aria-roledescription={isCarousel ? 'carousel' : undefined}
    >
      {slides.map((slide, i) => (
        <div
          class:list={['feature__slide', { 'is-active': i === 0 }]}
          data-slide
          role={isCarousel ? 'group' : undefined}
          aria-roledescription={isCarousel ? 'slide' : undefined}
          aria-label={isCarousel ? `${i + 1} / ${slides.length}` : undefined}
          aria-hidden={isCarousel && i !== 0 ? 'true' : undefined}
        >
          <Image
            class="feature__img"
            src={slide.src}
            alt={slide.alt}
            widths={[640, 1024, 1440]}
            sizes="(max-width: 860px) 100vw, 50vw"
            loading={i === 0 ? 'lazy' : 'eager'}
          />
        </div>
      ))}

      {isCarousel && (
        <div class="feature__nav">
          <button type="button" class="feature__arrow" data-prev aria-label={t('prevImage')}>
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none"
                 stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 5 8 12l7 7" />
            </svg>
          </button>
          <button type="button" class="feature__arrow" data-next aria-label={t('nextImage')}>
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none"
                 stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
              <path d="m9 5 7 7-7 7" />
            </svg>
          </button>
        </div>
      )}
    </figure>

    <div class="feature__panel">
      <div class="feature__body">
        <h2 class="feature__title" id={`${id}-heading`} data-reveal>
          {lines.map((line, i) => (
            <span class:list={['feature__line', { 'is-strong': i >= emphasisFrom }]}>{line}</span>
          ))}
          {sub && <span class="feature__sub">{sub}</span>}
        </h2>
        <hr class="feature__rule" data-reveal="fade" />
      </div>
    </div>
  </div>
</section>

<style>
  .feature { scroll-margin-top: var(--header-h); }

  .feature__inner {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: stretch;
    min-height: clamp(360px, 42vw, 560px);
  }

  /* Default is panel-left, image-right; flip swaps them. */
  .feature__figure { order: 2; margin: 0; }
  .feature__panel { order: 1; }
  .feature--flip .feature__figure { order: 1; }
  .feature--flip .feature__panel { order: 2; }

  .feature__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* --- Carousel -----------------------------------------------------------
     Slides are stacked and cross-faded. The first is in normal flow so it
     sets the figure's height; the rest are layered over it. With JavaScript
     off, that first slide is simply the photograph — nothing is hidden that
     the visitor cannot reach.                                              */

  .feature__figure--carousel { position: relative; }

  .feature__slide { height: 100%; }

  .feature__figure--carousel .feature__slide:not(:first-child) {
    position: absolute;
    inset: 0;
  }

  .feature__figure--carousel .feature__slide {
    opacity: 0;
    transition: opacity var(--dur-slow) var(--ease-out);
  }
  .feature__figure--carousel .feature__slide.is-active { opacity: 1; }

  .feature__nav {
    position: absolute;
    right: var(--s-5);
    bottom: var(--s-5);
    z-index: 2;
    display: flex;
    gap: var(--s-2);
  }

  .feature__arrow {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid rgba(255, 253, 249, 0.55);
    border-radius: 50%;
    background: rgba(8, 35, 65, 0.28);
    color: var(--off-white);
    backdrop-filter: blur(6px);
    transition: background var(--dur-fast) var(--ease-out),
                border-color var(--dur-fast) var(--ease-out),
                color var(--dur-fast) var(--ease-out);
  }
  .feature__arrow:hover {
    background: var(--gold);
    border-color: var(--gold);
    color: var(--navy);
  }

  .feature__panel {
    display: grid;
    align-items: center;
    padding: clamp(var(--s-6), 6vw, var(--s-10));
    min-width: 0;
    overflow: clip;
  }

  .feature--alt .feature__panel { background: var(--ground); }
  .feature--grey .feature__panel { background: var(--warm-gray); }

  .feature__body {
    display: grid;
    justify-items: start;
    gap: var(--s-5);
    margin-inline: auto;
  }

  .feature--end .feature__body { justify-items: end; text-align: right; }

  .feature__title {
    display: grid;
    gap: 0.1em;
    font-size: clamp(1.5rem, 1rem + 1.9vw, 2.6rem);
    font-weight: var(--w-thin);
    letter-spacing: var(--track-heading);
    line-height: 1.22;
    text-transform: uppercase;
    color: var(--ink);
  }

  .feature--end .feature__title { justify-items: end; }

  /* Each entry is one deliberate line; wrapping would change the composition. */
  .feature__line { white-space: nowrap; }
  .feature__line.is-strong { font-weight: var(--w-light); }

  .feature__sub {
    justify-self: end;
    margin-top: 0.15em;
    font-size: 0.5em;
    letter-spacing: 0.02em;
    text-transform: none;
    color: var(--ink-muted);
  }

  .feature__rule {
    width: min(100%, 320px);
    height: 1px;
    border: 0;
    background: var(--rule);
  }

  /* On the grey panel the ink lightens to hold contrast. */
  .feature--grey .feature__title { color: var(--off-white); }
  .feature--grey .feature__sub { color: rgba(255, 253, 249, 0.8); }
  .feature--grey .feature__rule { background: rgba(255, 253, 249, 0.5); }

  @media (prefers-reduced-motion: reduce) {
    .feature__figure--carousel .feature__slide { transition: none; }
  }

  @media (max-width: 860px) {
    /* Stacked: image first on every band, so the rhythm stays predictable. */
    .feature__inner { grid-template-columns: 1fr; min-height: 0; }
    .feature__figure,
    .feature--flip .feature__figure { order: 1; }
    .feature__panel,
    .feature--flip .feature__panel { order: 2; }

    .feature__img { height: auto; aspect-ratio: 16 / 10; }
    .feature__body { margin-inline: 0; }
    .feature__line { white-space: normal; }

    /* Right-aligned panels return to the reading edge once stacked. */
    .feature--end .feature__body,
    .feature--end .feature__title { justify-items: start; text-align: left; }

    .feature__nav { right: var(--s-4); bottom: var(--s-4); }
    .feature__arrow { width: 38px; height: 38px; }
  }
</style>

<script>
  /* Cross-fade carousel. Everything is progressive: without this script the
     first slide is already visible and the arrows simply never appear, since
     they are only rendered when there is more than one slide. */
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((figure) => {
    const slides = [...figure.querySelectorAll<HTMLElement>('[data-slide]')];
    if (slides.length < 2) return;

    let index = 0;

    const show = (next: number) => {
      index = (next + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        const active = i === index;
        slide.classList.toggle('is-active', active);
        // Keep the inactive slides out of the accessibility tree entirely.
        if (active) slide.removeAttribute('aria-hidden');
        else slide.setAttribute('aria-hidden', 'true');
      });
    };

    figure.querySelector('[data-prev]')?.addEventListener('click', () => show(index - 1));
    figure.querySelector('[data-next]')?.addEventListener('click', () => show(index + 1));

    // Arrow keys step the carousel once it holds focus.
    figure.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); show(index - 1); }
      if (e.key === 'ArrowRight') { e.preventDefault(); show(index + 1); }
    });
  });
</script>
