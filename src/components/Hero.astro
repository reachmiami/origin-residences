---
import { localizePath, asset, type Locale } from '../i18n/ui';
import { getCopy } from '../content/copy';

/**
 * RETIRED — nothing imports this, and that is deliberate.
 *
 * The original homepage hero: the brand film autoplaying full-bleed under the
 * headline. The owner chose the sunset hero instead (HomeHero.astro), which is
 * what `/` mounts now. Kept on disk at the owner's request in case that
 * decision is reversed — so do not "clean it up" as dead code.
 *
 * The brand film itself is not retired: HomeHero plays the same
 * /video/origin-hero.mp4 on demand behind its VIEW TRAILER button. The only
 * other thing that belongs to this file is /hero-poster.jpg, also unused.
 * `c.home.heroCta` is likewise unused but left in all three locales.
 *
 * If it is ever remounted: it pairs with `darkHeader`, NOT
 * `headerVariant="home"` — it has no flying logo, so the bar must carry its
 * own static one.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = getCopy(locale);
const L = (p: string) => localizePath(p, locale);
---

<section class="hero" aria-labelledby="hero-heading">
  {/* Brand film, muted and decorative — the headline carries the meaning, so
      the video is aria-hidden and never gatekeeps content. */}
  <video
    class="hero__media"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    poster={asset("hero-poster.jpg")}
    aria-hidden="true"
    tabindex="-1"
  >
    <source src={asset("video/origin-hero.mp4")} type="video/mp4" />
  </video>

  <div class="hero__veil" aria-hidden="true"></div>

  <div class="hero__content shell">
    <h1 class="display hero__headline" id="hero-heading">{c.home.heroHeadline}</h1>
    <hr class="hero__rule" />
    <a class="btn btn--ghost hero__cta" href={L('residences')}>
      <span>{c.home.heroCta}</span>
      <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" fill="none"
           stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
        <path d="M7 7h10v10" /><path d="M7 17 17 7" />
      </svg>
    </a>
  </div>

  <a class="hero__scroll" href="#main-intro" aria-label="Scroll to content">
    <span class="hero__scroll-line" aria-hidden="true"></span>
  </a>
</section>

<span id="main-intro" class="visually-hidden"></span>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: end;
    min-height: 100svh;
    padding-block: calc(var(--header-h) + var(--s-7)) clamp(var(--s-8), 10vh, var(--s-10));
    overflow: clip;
    background: var(--navy);
    color: var(--ink-on-dark);
    isolation: isolate;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Navy-weighted scrim. The film cuts between a groundbreaking crowd and its
     own end title card, so a light wash is not enough — thin white caps over
     hard hats were genuinely unreadable. Two layers: a flat navy tint to hold
     a floor of contrast on every frame, and a bottom-weighted gradient that
     buries the video's baked-in title card behind the headline and CTA. */
  .hero__veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(
        to top,
        rgba(5, 25, 47, 0.94) 0%,
        rgba(8, 35, 65, 0.78) 38%,
        rgba(8, 35, 65, 0.58) 72%,
        rgba(8, 35, 65, 0.66) 100%
      ),
      rgba(8, 35, 65, 0.28);
  }

  .hero__content {
    display: grid;
    justify-items: start;
    gap: var(--s-5);
    max-width: 1180px;
  }

  /* The headline runs 63 characters, and at the shared display size with the
     brand's wide tracking it broke to six lines on desktop and eight on phone,
     swallowing the viewport and pushing the CTA off the fold. It gets its own
     smaller ramp and a wider measure so it settles at three or four lines. */
  .hero__headline {
    max-width: 26ch;
    font-size: clamp(1.75rem, 0.95rem + 3.1vw, 3.5rem);
    color: var(--off-white);
    text-wrap: balance;
    text-shadow: 0 1px 24px rgba(5, 25, 47, 0.5);
  }

  .hero__rule {
    width: clamp(64px, 8vw, 120px);
    height: 1px;
    border: 0;
    background: var(--gold);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-4) var(--s-6);
    font-size: var(--t-micro);
    font-weight: var(--w-light);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    border: 1px solid currentColor;
    transition: background var(--dur-base) var(--ease-out),
                color var(--dur-base) var(--ease-out),
                border-color var(--dur-base) var(--ease-out);
  }

  .btn svg { transition: transform var(--dur-base) var(--ease-out); }
  .btn:hover svg { transform: translate(3px, -3px); }

  .btn--ghost { color: var(--off-white); border-color: rgba(255, 253, 249, 0.6); }
  .btn--ghost:hover {
    background: var(--gold);
    border-color: var(--gold);
    color: var(--off-white);
  }

  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: var(--s-5);
    translate: -50% 0;
    display: grid;
    place-items: center;
    width: 40px;
    height: 56px;
  }

  .hero__scroll-line {
    width: 1px;
    height: 46px;
    background: linear-gradient(to bottom, transparent, var(--gold));
    transform-origin: top;
    animation: drop 2.4s var(--ease-in-out) infinite;
  }

  @keyframes drop {
    0%   { transform: scaleY(0); opacity: 0; }
    40%  { transform: scaleY(1); opacity: 1; }
    100% { transform: scaleY(1); opacity: 0; }
  }

  @media (max-width: 640px) {
    .hero { min-height: 92svh; }
    .hero__headline { max-width: 16ch; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__scroll-line { animation: none; opacity: 1; transform: none; }
  }
</style>

<script>
  // Respect reduced motion for the background film, which autoplay alone
  // would otherwise force on every visitor.
  const video = document.querySelector<HTMLVideoElement>('.hero__media');
  if (video && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    video.removeAttribute('autoplay');
    video.pause();
  }
</script>
