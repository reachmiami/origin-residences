---
import { useTranslations, localizePath, type Locale } from '../i18n/ui';
import { getCopy } from '../content/copy';
import { unitsByLevel, unitCount, bedOptions, formatSqft } from '../data/units';

interface Props {
  locale: Locale;
  headingId?: string;
}

const { locale, headingId = 'inventory-heading' } = Astro.props;
const t = useTranslations(locale);
const c = getCopy(locale);
const L = (p: string) => localizePath(p, locale);

/* Level 5 and PH Level 5 share a floor number, so the filter key carries the
   penthouse flag as well — the label alone is not unique enough to match on. */
const levelGroups = unitsByLevel.map((g) => {
  const isPenthouse = g.units[0]?.isPenthouse ?? false;
  return {
    ...g,
    key: `${g.level}-${isPenthouse ? 'ph' : 'std'}`,
    short: isPenthouse ? `PH ${g.level}` : String(g.level),
  };
});
---

<section class="inv section" id="inventory" aria-labelledby={headingId} data-inventory>
  <div class="shell">
    <header class="inv__head">
      <div class="inv__titles">
        <h2 class="heading" id={headingId} data-reveal>{c.home.inventoryTitle}</h2>
        <p class="inv__limited" data-reveal data-reveal-delay="0.06">{c.home.inventoryLimited}</p>
      </div>
      <p class="inv__status" role="status">
        <span class="inv__figure" data-count>{unitCount}</span>
        <span class="inv__of">/ {unitCount} {t('residences')}</span>
      </p>
    </header>

    {/* Inert markup without the script below, so the bar only appears once the
        filtering it promises actually works. All 27 stay visible either way. */}
    <form class="filters" data-filters hidden>
      <fieldset class="filterset">
        <legend class="filterset__legend">{t('bedrooms')}</legend>
        <div class="filterset__opts">
          <label class="pill">
            <input type="radio" name="beds" value="all" checked />
            <span>{t('filterAll')}</span>
          </label>
          {bedOptions.map((b) => (
            <label class="pill">
              <input type="radio" name="beds" value={String(b)} />
              <span>{b}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <fieldset class="filterset">
        <legend class="filterset__legend">{t('level')}</legend>
        <div class="filterset__opts">
          <label class="pill">
            <input type="radio" name="level" value="all" checked />
            <span>{t('filterAll')}</span>
          </label>
          {levelGroups.map((g) => (
            <label class="pill">
              <input type="radio" name="level" value={g.key} />
              <span>{g.short}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <button class="filters__clear" type="button" data-clear hidden>{t('clearFilters')}</button>
    </form>

    <ul class="levels">
      {levelGroups.map((group) => (
        <li class="level" data-level-group data-level={group.key}>
          <div class="level__head">
            <h3 class="level__label">{group.label}</h3>
            <p class="level__meta">
              <span data-level-count>{group.units.length}</span> {t('residences')}
            </p>
          </div>

          <ul class="level__units" data-reveal-group>
            {group.units.map((u) => (
              <li class="unit" data-unit data-beds={String(u.beds)} data-level={group.key}>
                <a class="unit__link" href={L(u.slug)}>
                  <span class="unit__no">
                    <span class="visually-hidden">{t('unit')} </span>{u.number}
                  </span>
                  <span class="unit__beds">{u.bedBathLabel}</span>
                  <dl class="unit__specs">
                    <div class="spec">
                      <dt>{t('interior')}</dt>
                      <dd>{formatSqft(u.interiorSqft)} sq. ft. <span class="spec__alt">/ {u.interiorM2} m&sup2;</span></dd>
                    </div>
                    <div class="spec">
                      <dt>{t('total')}</dt>
                      <dd>{formatSqft(u.totalSqft)} sq. ft. <span class="spec__alt">/ {u.totalM2} m&sup2;</span></dd>
                    </div>
                  </dl>
                  <span class="unit__go" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor"
                         stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M7 7h10v10" /><path d="M7 17 17 7" />
                    </svg>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ul>

    <p class="inv__empty" data-empty hidden>{t('noResults')}</p>
  </div>
</section>

<style>
  /* Filtering hides rows outright; grid/flex display would otherwise win. */
  [hidden] { display: none !important; }

  .inv { background: var(--ground-alt); }

  .inv__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--s-4);
    padding-bottom: var(--s-5);
    border-bottom: 1px solid var(--rule);
  }

  .inv__titles { display: grid; gap: var(--s-3); }

  .inv__limited {
    font-size: var(--t-micro);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .inv__status { display: flex; align-items: baseline; gap: var(--s-3); }

  .inv__figure {
    font-size: var(--t-h2);
    font-weight: var(--w-thin);
    letter-spacing: var(--track-display);
    color: var(--gold-ink);
  }

  .inv__of {
    font-size: var(--t-micro);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  /* --- Filter bar --------------------------------------------------------- */

  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--s-5) var(--s-7);
    margin-top: var(--s-6);
  }

  .filterset { border: 0; padding: 0; margin: 0; min-width: 0; }

  .filterset__legend {
    padding: 0;
    margin-bottom: var(--s-3);
    font-size: var(--t-micro);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .filterset__opts { display: flex; flex-wrap: wrap; gap: var(--s-2); }

  .pill {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 var(--s-4);
    border: 1px solid var(--rule);
    font-size: var(--t-micro);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--ink);
    cursor: pointer;
    transition: border-color var(--dur-fast) var(--ease-out),
                background var(--dur-fast) var(--ease-out),
                color var(--dur-fast) var(--ease-out);
  }

  /* Kept in the tab order and operable; only the native dot is suppressed. */
  .pill input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .pill:hover { border-color: var(--gold); }

  .pill:has(input:checked) {
    background: var(--navy);
    border-color: var(--navy);
    color: var(--off-white);
  }

  .pill:has(input:focus-visible) {
    outline: 2px solid var(--focus-ring);
    outline-offset: 3px;
  }

  .filters__clear {
    align-self: end;
    min-height: 40px;
    padding: 0 var(--s-2);
    font-size: var(--t-micro);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--gold-ink);
    border-bottom: 1px solid currentColor;
  }
  .filters__clear:hover { color: var(--ink); }

  /* --- Levels ------------------------------------------------------------- */

  .levels { display: grid; gap: var(--s-6); margin-top: var(--s-8); }

  .level {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: var(--s-5);
    align-items: start;
    padding-top: var(--s-5);
    border-top: 1px solid var(--rule);
  }

  .level__head { display: grid; gap: var(--s-1); padding-top: var(--s-2); }

  .level__label {
    font-size: var(--t-h4);
    font-weight: var(--w-xlight);
    letter-spacing: var(--track-heading);
    text-transform: uppercase;
    color: var(--ink);
  }

  .level__meta {
    font-size: var(--t-micro);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .level__units {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(238px, 1fr));
    gap: var(--s-3);
  }

  /* --- Unit card ---------------------------------------------------------- */

  .unit__link {
    position: relative;
    display: grid;
    gap: var(--s-3);
    height: 100%;
    padding: var(--s-5) var(--s-4);
    background: var(--off-white);
    border: 1px solid transparent;
    transition: border-color var(--dur-fast) var(--ease-out),
                transform var(--dur-fast) var(--ease-out);
  }
  .unit__link:hover { border-color: var(--gold); transform: translateY(-3px); }

  .unit__no {
    font-size: var(--t-h3);
    font-weight: var(--w-thin);
    letter-spacing: var(--track-heading);
    line-height: 1;
  }

  .unit__beds {
    font-size: var(--t-micro);
    letter-spacing: var(--track-body);
    text-transform: uppercase;
    color: var(--ink);
  }

  .unit__specs {
    display: grid;
    gap: var(--s-2);
    margin: 0;
    padding-top: var(--s-3);
    border-top: 1px solid var(--rule);
  }

  .spec { display: grid; gap: 2px; }

  .spec dt {
    font-size: var(--t-micro);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .spec dd {
    margin: 0;
    font-size: var(--t-small);
    font-weight: var(--w-light);
    letter-spacing: var(--track-body);
  }

  .spec__alt { color: var(--ink-muted); }

  .unit__go {
    position: absolute;
    top: var(--s-5);
    right: var(--s-4);
    color: var(--gold-muted);
    transition: transform var(--dur-base) var(--ease-out),
                color var(--dur-base) var(--ease-out);
  }
  .unit__link:hover .unit__go { transform: translate(3px, -3px); color: var(--gold-ink); }

  .inv__empty {
    margin-top: var(--s-7);
    padding-top: var(--s-6);
    border-top: 1px solid var(--rule);
    font-size: var(--t-small);
    letter-spacing: var(--track-body);
    color: var(--ink-muted);
  }

  @media (max-width: 860px) {
    .level { grid-template-columns: 1fr; gap: var(--s-4); }
    .level__head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: var(--s-3);
      padding-top: 0;
    }
  }

  @media (max-width: 520px) {
    .filters { gap: var(--s-5); }
    .level__units { grid-template-columns: 1fr; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-inventory]');

  if (root) {
    const form = root.querySelector<HTMLFormElement>('[data-filters]');
    const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-unit]'));
    const groups = Array.from(root.querySelectorAll<HTMLElement>('[data-level-group]'));
    const count = root.querySelector<HTMLElement>('[data-count]');
    const empty = root.querySelector<HTMLElement>('[data-empty]');
    const clear = root.querySelector<HTMLElement>('[data-clear]');

    // The bar ships hidden so a failed script never leaves dead controls.
    if (form) form.hidden = false;

    const chosen = (name: string): string =>
      form?.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`)?.value ?? 'all';

    const apply = (): void => {
      const beds = chosen('beds');
      const level = chosen('level');
      let visible = 0;

      cards.forEach((card) => {
        const match =
          (beds === 'all' || card.dataset.beds === beds) &&
          (level === 'all' || card.dataset.level === level);
        card.hidden = !match;
        if (match) visible += 1;
      });

      groups.forEach((group) => {
        const shown = group.querySelectorAll('[data-unit]:not([hidden])').length;
        group.hidden = shown === 0;
        const n = group.querySelector<HTMLElement>('[data-level-count]');
        if (n) n.textContent = String(shown);
      });

      if (count) count.textContent = String(visible);
      if (empty) empty.hidden = visible > 0;
      if (clear) clear.hidden = beds === 'all' && level === 'all';

      // Hiding rows changes document height; nudge ScrollTrigger to re-measure.
      window.dispatchEvent(new Event('resize'));
    };

    // Nothing to post — the filter form exists only to group the controls.
    form?.addEventListener('submit', (e) => e.preventDefault());
    form?.addEventListener('change', apply);
    clear?.addEventListener('click', () => {
      form?.reset();
      apply();
    });
  }
</script>
