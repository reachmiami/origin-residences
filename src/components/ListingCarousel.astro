---
/**
 * The photographic hero of a listing page — a filmstrip.
 *
 * One row of photographs side by side, separated by a hairline gap, scrolled
 * left and right. Not a stack that cross-fades: the point of the row is that a
 * visitor sees there is more to look at without being told, because the next
 * frame is already half in view.
 *
 * ─── WHY A NATIVE SCROLLER ─────────────────────────────────────────────────
 * The track is an ordinary overflow-x container with scroll snapping. That is
 * what makes swipe work — on a touch screen and on a trackpad — with real
 * momentum and rubber-banding, none of which a JavaScript slider reproduces
 * convincingly. The buttons only call `scrollBy`. So the hero works with the
 * script disabled, works with a finger, works with a trackpad, and works from
 * the keyboard because the track itself is focusable.
 *
 * The arrows ship `hidden` and are revealed by the script, the same way the
 * inventory filter bar used to: a control that promises to do something must
 * not appear until it can.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { type Locale } from '../i18n/ui';
import { listingsCopy, fillCounter } from '../content/pages/listings';

export interface Slide {
  src: ImageMetadata;
  alt: string;
}

interface Props {
  slides: Slide[];
  locale: Locale;
  /** Residence number, for the group's accessible name. */
  residence: string;
}

const { slides, locale, residence } = Astro.props;
const l = listingsCopy[locale];
const isCarousel = slides.length > 1;
const label = l.galleryLabel(residence);
---

<section class="lcar" aria-roledescription="carousel" aria-label={label}>
  {/* tabindex makes the scroll region reachable from the keyboard, which is
      what lets arrow keys pan it — a scrollable box that cannot be focused is
      unreachable without a mouse. It carries its own name because it is now a
      landmark a screen reader will stop on. */}
  <ul
    class="lcar__track"
    data-track
    tabindex="0"
    role="group"
    aria-label={label}
  >
    {slides.map((slide, i) => (
      <li class="lcar__slide" data-slide>
        <Image
          src={slide.src}
          alt={slide.alt}
          widths={[600, 900, 1200, 1600]}
          sizes="(max-width: 700px) 88vw, 62vw"
          loading={i === 0 ? 'eager' : 'lazy'}
          fetchpriority={i === 0 ? 'high' : undefined}
          class="lcar__img"
        />
      </li>
    ))}
  </ul>

  {isCarousel && (
    <>
      <button
        type="button"
        class="lcar__arrow lcar__arrow--prev"
        data-prev
        hidden
        aria-label={l.previousImage}
      >
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none"
             stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
          <path d="M15 5 8 12l7 7" />
        </svg>
      </button>

      <button
        type="button"
        class="lcar__arrow lcar__arrow--next"
        data-next
        hidden
        aria-label={l.nextImage}
      >
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none"
             stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
          <path d="m9 5 7 7-7 7" />
        </svg>
      </button>

      <p
        class="lcar__counter"
        data-counter
        data-template={l.imageCounterTemplate}
        role="status"
        aria-live="polite"
      >
        {fillCounter(l.imageCounterTemplate, 1, slides.length)}
      </p>
    </>
  )}
</section>

<style>
  .lcar {
    position: relative;
    background: var(--navy);
  }

  /* The page carries a transparent header over this hero, and the first frame
     is a sunlit exterior — the wordmark and the language switcher were washing
     out against the sky. Same top-down scrim the homepage hero uses, and the
     same stops, so the two heroes hold the bar the same way. It sits above the
     photographs and below the controls, and takes no pointer events, so a
     swipe still reaches the track underneath.

     It is carried deeper than the homepage's: that hero opens on a sunset,
     which is dark where the bar sits, while the first frame here is a sunlit
     facade against open sky — the brightest ground the wordmark ever has to
     hold against. */
  .lcar::before {
    content: '';
    position: absolute;
    z-index: 1;
    top: 0;
    right: 0;
    left: 0;
    height: 46%;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--navy-deep) 52%, transparent) 0%,
      color-mix(in srgb, var(--navy-deep) 30%, transparent) 30%,
      color-mix(in srgb, var(--navy-deep) 10%, transparent) 62%,
      transparent 100%
    );
  }

  .lcar__track {
    display: flex;
    /* The hairline between frames. The navy ground behind shows through it,
       so the gap reads as a seam rather than as empty page. */
    gap: 2px;
    height: 70vh;
    min-height: 300px;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    overflow-y: hidden;
    /* Snapping is `proximity`, not `mandatory`: with frames narrower than the
       viewport a mandatory snap fights a visitor who wants to rest between
       two of them, and yanks the strip about on every small trackpad nudge. */
    scroll-snap-type: x proximity;
    scroll-behavior: smooth;
    overscroll-behavior-x: contain;
    /* The arrows and the half-visible next frame are the affordance; a
       scrollbar under a full-bleed hero is not part of the picture. */
    scrollbar-width: none;
  }

  .lcar__track::-webkit-scrollbar {
    display: none;
  }

  .lcar__track:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: -2px;
  }

  /* Sized from the VIEWPORT, not from an aspect ratio, so that a slice of the
     next frame is always showing whatever the window is — that peek is what
     tells a visitor the row continues. */
  .lcar__slide {
    flex: 0 0 auto;
    width: min(62vw, 1040px);
    height: 100%;
    scroll-snap-align: start;
  }

  .lcar__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .lcar__arrow {
    position: absolute;
    z-index: 2;
    top: 50%;
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border: 1px solid var(--rule-on-dark);
    background: color-mix(in srgb, var(--navy) 55%, transparent);
    color: var(--off-white);
    cursor: pointer;
    transform: translateY(-50%);
    transition: background var(--dur-fast) var(--ease-out), opacity var(--dur-fast) var(--ease-out);
  }

  .lcar__arrow:hover {
    background: color-mix(in srgb, var(--navy) 80%, transparent);
  }

  /* At either end the button stays in place but stops inviting a press —
     removing it would shift the other one and make the pair jump. */
  .lcar__arrow[disabled] {
    cursor: default;
    opacity: 0.3;
  }

  .lcar__arrow--prev { left: var(--s-4); }
  .lcar__arrow--next { right: var(--s-4); }

  .lcar__counter {
    position: absolute;
    z-index: 2;
    right: var(--s-4);
    bottom: var(--s-4);
    margin: 0;
    padding: var(--s-2) var(--s-3);
    background: color-mix(in srgb, var(--navy) 70%, transparent);
    color: var(--off-white);
    font-size: var(--t-micro);
    letter-spacing: var(--track-label);
  }

  @media (max-width: 700px) {
    .lcar__slide { width: 88vw; }
    .lcar__arrow { width: 38px; height: 38px; }
    .lcar__arrow--prev { left: var(--s-2); }
    .lcar__arrow--next { right: var(--s-2); }
  }

  @media (prefers-reduced-motion: reduce) {
    .lcar__track { scroll-behavior: auto; }
    .lcar__arrow { transition: none; }
  }
</style>

<script>
  /* The track scrolls on its own — swipe, trackpad and arrow keys all work
     with this file absent. Everything below is addition: the buttons, the
     frame counter, and disabling a button at the end of the row. */
  document.querySelectorAll<HTMLElement>('.lcar').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]');
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    if (!track || slides.length < 2) return;

    const prev = root.querySelector<HTMLButtonElement>('[data-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-next]');
    const counter = root.querySelector<HTMLElement>('[data-counter]');

    // The controls do something now, so they may appear.
    if (prev) prev.hidden = false;
    if (next) next.hidden = false;

    /** One frame plus the seam — the distance a press should travel. */
    const step = () => {
      const a = slides[0].getBoundingClientRect();
      const b = slides[1]?.getBoundingClientRect();
      return b ? b.left - a.left : a.width;
    };

    const update = () => {
      const max = track.scrollWidth - track.clientWidth;
      /* A pixel of tolerance: fractional layout widths mean scrollLeft rarely
         reaches `max` exactly, and without it the last frame never disables
         the forward button. */
      if (prev) prev.disabled = track.scrollLeft <= 1;
      if (next) next.disabled = track.scrollLeft >= max - 1;

      if (counter) {
        /* At the far right the track stops with the last frame flush to the
           edge, which by division is still the second-to-last index — the
           counter would sit on "5 of 6" and never reach the end of its own
           row. Resting against the end means you are on the last frame. */
        const index =
          track.scrollLeft >= max - 1
            ? slides.length - 1
            : Math.min(
                slides.length - 1,
                Math.round(track.scrollLeft / Math.max(1, step())),
              );
        const tpl = counter.dataset.template ?? '{current} of {total}';
        counter.textContent = tpl
          .replace('{current}', String(index + 1))
          .replace('{total}', String(slides.length));
      }
    };

    prev?.addEventListener('click', () => track.scrollBy({ left: -step() }));
    next?.addEventListener('click', () => track.scrollBy({ left: step() }));

    /* Scroll fires continuously through a swipe; the counter only needs the
       resting value, so the work is deferred to the next frame. */
    let queued = false;
    track.addEventListener('scroll', () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        update();
      });
    }, { passive: true });

    window.addEventListener('resize', update, { passive: true });
    update();
  });
</script>
