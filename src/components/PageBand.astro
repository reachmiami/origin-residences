---
import { Image } from 'astro:assets';

/**
 * The photographic page title band.
 *
 * Lifted verbatim from the Residences page, which is where this treatment
 * started, and now shared by every page that carries a title. Extracting it was
 * not optional at this scale: Astro scopes styles per file, so leaving it inline
 * would have meant ten copies of the same forty lines of CSS, drifting apart the
 * first time anyone adjusted the veil.
 *
 * `.band` is deliberately NOT a global class. Several pages already use that
 * name for something else entirely — a plain image `<div>` on Amenities, a
 * `<figure>` on Artefacto — and they only coexist because Astro scopes them.
 * Anything global here would collide with all of them.
 */
interface Props {
  image: ImageMetadata;
  alt: string;
  /** Small tracked caps above the title. */
  eyebrow?: string;
  title: string;
  /** Short line under the rule. Omitted where a page has no such copy — this
      band is not a reason to invent marketing prose for a legal page. */
  lede?: string;
  /** Must match the `aria-labelledby` the page expects. */
  headingId?: string;
  /** Eager-load the image. True for the first thing on the page, which is
      almost always this. */
  eager?: boolean;
  /**
   * How far up from the band's foot the veil stays at full strength. The
   * default suits a two- or three-line title block; a page whose headline wraps
   * further needs more, or its top line ends up on unveiled photograph. Only
   * Artefacto needs this today — check with `measure-band.mjs` before changing.
   */
  veilHold?: string;
}

const {
  image,
  alt,
  eyebrow,
  title,
  lede,
  headingId = 'page-heading',
  eager = true,
  veilHold,
} = Astro.props;
---

<section class="band" aria-labelledby={headingId}>
  <Image
    class="band__media"
    src={image}
    alt={alt}
    widths={[640, 990, 1228, 1600]}
    sizes="100vw"
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
  />
  <div class="band__veil" aria-hidden="true" style={veilHold ? `--veil-hold:${veilHold}` : undefined}></div>

  <div class="shell band__inner">
    {eyebrow && <p class="eyebrow band__eyebrow">{eyebrow}</p>}
    <h1 class="display band__title" id={headingId}>{title}</h1>
    <hr class="band__rule" />
    {lede && <p class="band__lede">{lede}</p>}
    <slot />
  </div>
</section>

<style>
  .band {
    position: relative;
    display: grid;
    align-items: end;
    min-height: clamp(420px, 62svh, 614px);
    padding-block: calc(var(--header-h) + var(--s-7)) clamp(var(--s-7), 6vh, var(--s-9));
    overflow: clip;
    background: var(--navy);
    color: var(--ink-on-dark);
    isolation: isolate;
  }

  .band__media {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* The veil has to be dark WHERE THE TYPE IS, which is not the same as dark at
     the foot of the band. One veil across the whole band, not a pool around the
     copy — the localised version read as a panel sitting behind the words.

     The original gradient ran 0.88 at the very bottom but only 0.42–0.58 across
     the strip the copy actually occupies, because the copy is bottom-aligned
     above a `clamp(3rem, 6vh, 6rem)` pad. Measured against composited pixels
     that left every band page below AA — the Residences eyebrow at 1.40:1, the
     best page anywhere 3.26:1.

     So the hold is anchored in PIXELS from the foot, sized to the copy block
     rather than to a share of a band whose height varies. The eyebrow is the
     binding constraint: --gold-light is close in luminance to sunlit
     photography and needs roughly 0.85 of navy over a blown-out highlight to
     clear 4.5:1. Above the hold the veil releases so the photograph still
     reads, then lifts again at the very top, where the transparent header's own
     type sits. A page whose headline wraps further can raise the hold through
     the `veilHold` prop — Artefacto does. */
  .band__veil {
    --veil-hold: clamp(320px, 46vh, 430px);

    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--navy) 94%, transparent) 0,
      color-mix(in srgb, var(--navy) 88%, transparent) var(--veil-hold),
      color-mix(in srgb, var(--navy) 26%, transparent) calc(var(--veil-hold) + 170px),
      color-mix(in srgb, var(--navy) 52%, transparent) 100%
    );
  }

  .band__inner { display: grid; justify-items: start; gap: var(--s-4); max-width: 1180px; }

  .band__eyebrow { color: var(--gold-light); }

  .band__title { color: var(--off-white); }

  .band__rule {
    width: clamp(64px, 8vw, 120px);
    height: 1px;
    border: 0;
    background: var(--gold);
  }

  .band__lede {
    max-width: 46ch;
    font-size: var(--t-small);
    font-weight: var(--w-light);
    letter-spacing: var(--track-body);
    text-transform: uppercase;
    color: var(--ink-on-dark-muted);
  }
</style>
